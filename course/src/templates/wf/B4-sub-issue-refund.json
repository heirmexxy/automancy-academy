    {
      "parameters": {
        "jsCode": "// Hard limits: code decides, not the model.\nconst t = $('When Executed by Another Workflow').first().json;\nconst chat_id = String(t.chat_id ?? '');\nconst order_id = String(t.order_id ?? '').toUpperCase().trim();\nconst amount = Number(t.amount);\nconst reason = String(t.reason ?? '');\nconst order = $input.all().map(i => i.json).find(r => String(r.order_id).toUpperCase() === order_id);\nlet stop = null;\nif (!order)                                     stop = \"Order not found\";\nelse if (!chat_id)                              stop = \"No customer identity\";\nelse if (String(order.chat_id) !== chat_id)     stop = \"Order doesn't belong to this customer\";\nelse if (order.status !== 'Paid')               stop = \"Order not paid\";\nelse if (order.refunded === 'yes')              stop = \"Already refunded\";\nelse if (!(amount > 0) || amount > Number(order.total)) stop = \"Amount outside the order total\";\nelse if (amount > 50000)                        stop = \"Over ₦50,000: Tolu handles by phone\";\nreturn [{ json: { ok: !stop, stop, order_id, chat_id, amount, reason,\n  total: order ? Number(order.total) : null, status: order ? order.status : null,\n  paystack_ref: order ? order.paystack_ref : null, is_eval: String(t.is_eval) === 'true' } }];"
      },
