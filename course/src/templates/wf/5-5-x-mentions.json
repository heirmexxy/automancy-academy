    "jsCode": "const res = $('X mentions').first().json;\nconst users = Object.fromEntries((res.includes?.users || []).map(u => [u.id, u.username]));\nreturn (res.data || []).map(t => ({ json: {\n  platform: 'x', kind: 'mention', item_id: t.id, thread_id: t.conversation_id, author_handle: users[t.author_id] || t.author_id,\n  text: t.text, source_link: `https://x.com/i/web/status/${t.id}`, received_at: t.created_at, last_customer_msg_at: t.created_at } }));\n",
