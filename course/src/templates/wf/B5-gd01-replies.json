    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (\n  INSERT INTO suppression (value, channel, reason, at) VALUES (lower($2), 'all', $3, now())\n  ON CONFLICT (value) DO UPDATE SET reason = EXCLUDED.reason RETURNING value\n), u AS (UPDATE leads SET status = 'suppressed', reply_type = $3 WHERE lead_id = $1 RETURNING lead_id)\nINSERT INTO events (workflow, lead_id, event, detail) SELECT 'GD·01', lead_id, 'suppressed', jsonb_build_object('reason', $3) FROM u;",
        "options": {
          "queryReplacement": "={{ [ $('Find lead').item.json.lead_id, $('Find lead').item.json.email, $('Read reply').item.json.bounce ? 'bounce' : 'stop' ] }}"
        }
      },
      "id": "6710c4a8-5b72-43f2-8980-f42d16b43494",
