              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "labelIds": [
            "INBOX"
          ]
        },
        "options": {}
      },
      "id": "68b39179-617e-46f8-910e-fdaaba6b459b",
      "name": "Outreach inbox",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $json;\nconst from = String(j.from?.value?.[0]?.address || j.from?.text || j.From || '').toLowerCase().replace(/.*</, '').replace(/>.*/, '').trim();\nconst text = String(j.text || j.textPlain || j.snippet || '').split(/\\nOn .+ wrote:/)[0].trim().slice(0, 3000);\nconst subject = String(j.subject || j.Subject || '');\nconst bounce = /mailer-daemon|postmaster/.test(from) || /undeliverable|delivery status notification|address not found/i.test(subject);\nconst failedTo = bounce ? ((text.match(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g) || []).find(e => !/mailer-daemon|postmaster/.test(e)) || '') : '';\nreturn { json: { from: bounce ? failedTo.toLowerCase() : from, subject, text, threadId: j.threadId,\n  stop: /^\\s*(stop|unsubscribe|remove me|no more emails)\\b/i.test(text), bounce } };",
        "mode": "runOnceForEachItem"
      },
      "id": "a7a03f03-6154-453c-8241-e83e15784f6c",
      "name": "Read reply",
      "type": "n8n-nodes-base.code",
