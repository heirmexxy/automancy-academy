        "model": "YOUR_MODEL",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "0e0b2372-6f3e-4163-af5e-0e3f0f1c0889",
      "name": "Report model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        660,
        90
      ]
    },
    {
      "parameters": {
        "jsCode": "const n = $('Compute the week').first().json;\nconst words = String($input.first().json.text || '').trim();\nconst naira = x => '₦' + Math.round(Number(x || 0)).toLocaleString('en-NG');\nconst top = (n.top_products || []).map(t => `${t.product} (${t.qty})`).join(', ') || 'none';\nconst numbers = [\n  `Orders: ${n.orders}`,\n  `Revenue (paid): ${naira(n.revenue_ngn)}`,\n  `Top products: ${top}`,\n  `Late deliveries (over 3 h): ${n.late_deliveries}`,\n  `Refunds: ${n.refunds}`,\n  `AI spend: ${naira(n.ai_spend_ngn)}`\n];\nconst text = `📊 Harvest Lane · week report\\n${numbers.join('\\n')}\\n\\n${words}`;\nreturn [{ json: { text, subject: `Harvest Lane week report: ${n.orders} orders, ${naira(n.revenue_ngn)}` } }];"
      },
      "id": "f691351d-c94b-410b-ab5d-1b842b07b6fc",
      "name": "Assemble report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -90
      ]
    },
    {
      "parameters": {
        "sendTo": "tolu@harvestlane.example",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "e8921df5-39b8-4ce4-a3bd-293228c98035",
