    {
      "parameters": {
        "promptType": "define",
        "text": "=Numbers for last week (do not change them):\n{{ JSON.stringify($json) }}",
        "messages": {
          "messageValues": [
            {
              "message": "You write exactly three short sentences of commentary for Tolu, the owner of Harvest Lane (fresh-produce delivery, Ibadan), around the numbers you are given. Do not calculate, round or restate any number differently; do not invent numbers. If something looks worrying (late deliveries, refunds), say what to look at."
            }
          ]
        }
      },
      "id": "2f832380-fd88-414f-bf49-a45dfc51aa25",
      "name": "Three sentences",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        660,
        -90
      ]
    },
    {
