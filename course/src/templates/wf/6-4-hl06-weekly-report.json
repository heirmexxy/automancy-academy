{
  "name": "HL·06 Weekly report",
  "nodes": [
    {
      "parameters": {
        "content": "## HL·06 Weekly report (lesson 6.4)\nMonday 07:00. SQL computes the numbers; the AI only writes three sentences of commentary around numbers it's given and is told not to change them. Code calculates, AI explains.\n0 orders in a week = alert Tolu, don't send the report (Glitch's fault 3).\n\n**Credentials:** Postgres (Supabase), OpenAI, Gmail, Telegram.\n**Replace:** YOUR_MODEL, tolu@harvestlane.example (Tolu's email), YOUR_TELEGRAM_CHAT_ID.",
        "height": 320,
        "width": 400
      },
      "id": "060de830-ebb1-4d1f-b1ae-b1e58b6d54b4",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -528,
        -251
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1"
            }
          ]
        }
      },
      "id": "2b7eaf95-4147-4eab-8024-56420adc4686",
      "name": "Monday 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH wk AS (SELECT * FROM orders WHERE created_at >= date_trunc('week', now()) - interval '7 days'\n                                  AND created_at < date_trunc('week', now()))\nSELECT\n  (SELECT count(*) FROM wk) AS orders,\n  (SELECT coalesce(sum(total_ngn), 0) FROM wk WHERE paid_at IS NOT NULL) AS revenue_ngn,\n  (SELECT count(*) FROM wk WHERE status = 'refunded') AS refunds,\n  (SELECT json_agg(t) FROM (\n     SELECT i->>'name' AS product, sum((i->>'quantity')::int) AS qty\n     FROM wk, jsonb_array_elements(wk.items) i WHERE wk.paid_at IS NOT NULL\n     GROUP BY 1 ORDER BY 2 DESC LIMIT 3) t) AS top_products,\n  (SELECT count(*) FROM deliveries d JOIN wk ON wk.order_id = d.order_id\n     WHERE d.delivered_at > wk.paid_at + interval '3 hours') AS late_deliveries,\n  (SELECT coalesce(sum((detail->>'cost_ngn')::numeric), 0) FROM events\n     WHERE event = 'ai_usage' AND at >= date_trunc('week', now()) - interval '7 days'\n       AND at < date_trunc('week', now())) AS ai_spend_ngn;",
        "options": {}
      },
      "id": "c514194a-1d65-406f-aa90-a50f622b295c",
      "name": "Compute the week",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "e9a710b4-ebca-4e75-89e4-8a107791e470",
              "leftValue": "={{ Number($json.orders) }}",
              "operator": {
                "type": "number",
                "operation": "equals"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
