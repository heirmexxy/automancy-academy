        "categories": {
          "categories": [
            {
              "category": "order",
              "description": "The sender wants to buy, add to or change an order or delivery: items, quantities, dates or addresses. Includes repeat orders."
            },
            {
              "category": "complaint",
              "description": "The sender is unhappy about quality, lateness, damage, a rider's behaviour or service, even if polite. If they mainly want money back, choose refund."
            },
            {
              "category": "refund",
              "description": "The sender asks for money back, a double charge to be reversed, or credit for missing or damaged items."
            },
            {
              "category": "enquiry",
              "description": "A question about products, prices, opening hours or delivery areas, with no order placed yet."
            },
            {
              "category": "spam",
              "description": "Unsolicited marketing, prize or grant scams, phishing links, or anything unrelated to buying food from Harvest Lane. If unsure, do not choose spam."
            }
          ]
        },
        "options": {
          "fallback": "other"
