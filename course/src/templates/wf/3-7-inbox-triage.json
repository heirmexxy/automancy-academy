      "parameters": {
        "jsCode": "// 12 fake test emails (Card 4). expected = the right answer, written down first.\nconst emails = [\n  { expected: 'order', text: \"Please add 2 crates of tomatoes to tomorrow's delivery, order HL-0131.\" },\n  { expected: 'complaint', text: \"The pepper you delivered on Tuesday was rotten. This is the second time.\" },\n  { expected: 'refund', text: \"I was charged twice for HL-0127, please return ₦12,500.\" },\n  { expected: 'spam', text: \"Congratulations! You have won a $1,000,000 grant, click here.\" },\n  { expected: 'order', text: \"Can you deliver to Bodija on Saturday? I need 5 bunches of ugu.\" },\n  { expected: 'complaint', text: \"Your rider was rude to my staff at the gate.\" },\n  { expected: 'refund', text: \"I cancelled HL-0129 before dispatch but my money hasn't come back.\" },\n  { expected: 'enquiry', text: \"Do you sell organic carrots? What's the price per bag?\" },\n  { expected: 'spam', text: \"SEO services for your website, 50% off this week only.\" },\n  { expected: 'complaint', text: \"The onions were fine, but delivery came 3 hours late and my kitchen waited.\" },\n  { expected: 'enquiry', text: \"What are your opening hours on public holidays?\" },\n  { expected: 'refund', text: \"Half the eggs were broken. I want my money back for those.\" }\n];\nreturn emails.map((e, i) => ({ json: {\n  id: 'test-' + (i + 1),\n  From: 'customer' + (i + 1) + '@test.example',\n  Subject: 'Test email ' + (i + 1),\n  text: e.text,\n  expected: e.expected,\n} }));\n"
      },
