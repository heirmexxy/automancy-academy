    0
   ]
  },
  {
   "parameters": {
    "inputText": "=From: {{ $json.email }}\nSubject: {{ $json.subject }}\n\n{{ $json.text }}",
    "categories": {
     "categories": [
      {
       "category": "interested",
       "description": "Wants a sample, prices, a call or a meeting"
      },
      {
       "category": "not now",
       "description": "Polite no for now, maybe later"
      },
      {
       "category": "stop",
       "description": "Asks to stop, unsubscribe, remove them, or not to be contacted (including just STOP)"
      },
      {
       "category": "out of office",
       "description": "Automatic out-of-office or holiday reply"
      },
      {
       "category": "bounce",
       "description": "Delivery failure from a mail server: address not found, mailbox unavailable"
      },
      {
       "category": "other",
       "description": "Anything else"
      }
     ]
    },
    "options": {}
   },
