   "id": "eea9a04a-8391-49e4-baea-d10bf1435785",
   "name": "Brevo · last campaign stats",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    220,
    0
   ]
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "select count(*)::int as orders, coalesce(sum(total), 0)::numeric as revenue from orders where utm_source = 'email' and created_at > now() - interval '7 days';",
    "options": {}
   },
   "id": "ccbf95ec-ff65-4c54-a55d-d222cd2cb0eb",
   "name": "Orders from email (7 days)",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    440,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const c = ($('Brevo · last campaign stats').first().json.campaigns || [])[0] || {};\nconst g = c.statistics?.globalStats || {};\nconst delivered = g.delivered || 0;\nconst complaints = g.complaints || 0;\nconst rate = delivered ? complaints / delivered : 0;\nconst o = $json;\nconst text = [\n  `Email · ${c.name || 'no campaign'} · subject: ${c.subject || '-'}`,\n  `Delivered ${delivered} · clicks ${g.uniqueClicks || 0} · orders from email (7 days) ${o.orders} (₦${o.revenue})`,\n  `Unsubscribes ${g.unsubscriptions || 0} · hard bounces ${g.hardBounces || 0} · complaints ${complaints} (${(rate * 100).toFixed(2)}%)`,\n].join('\\n');\nreturn [{ json: { text, complaint_rate: rate, pause: rate > 0.001 } }];\n",
    "mode": "runOnceForAllItems"
   },
   "id": "d42c14e2-e064-4ca0-9aa5-f6ed2f017d15",
   "name": "Numbers",
