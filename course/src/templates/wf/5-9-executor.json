    {
      "parameters": {
        "jsCode": "const ALLOW = ['merge_companies', 'bulk_update_property', 'create_task', 'require_field', 'score_weight'];\nconst NEVER_FIELDS = ['dealstage', 'pipeline', 'hubspot_owner_id', 'marketing_consent', 'consent_date', 'hs_email_optout', 'lifecyclestage'];\nconst p = $json;\nconst d = p.details || {};\nlet reason = '';\nif (!ALLOW.includes(p.action)) reason = `action ${p.action} is not on the allow-list`;\nif (p.action === 'bulk_update_property' && NEVER_FIELDS.includes(String(d.property).trim().toLowerCase())) reason = `property ${d.property} can't be changed by the executor`;\n// object_type goes into the URL: only these three, so nothing else (archive, merge, associations) can be reached.\nif (p.action === 'bulk_update_property' && !['contacts', 'companies', 'deals'].includes(String(d.object_type))) reason = `object type ${d.object_type} is not allowed`;\nif (p.action === 'merge_companies' && (!d.primary_id || !d.merge_id)) reason = 'merge needs primary_id and merge_id';\nif (!reason && p.action === 'bulk_update_property' && !(Array.isArray(p.target_ids) && p.target_ids.length && d.object_type && d.property)) reason = 'bulk update needs target_ids, object_type and property';\nreturn { ...p, details: d, allowed: !reason, reason };\n",
        "mode": "runOnceForEachItem"
      },
