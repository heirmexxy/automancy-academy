   "id": "d29ac264-a122-43be-b69f-54032c1c3e4c",
   "name": "Send the photo",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1100,
    0
   ]
  },
  {
   "parameters": {
    "operation": "sendAndWait",
    "chatId": "YOUR_TELEGRAM_CHAT_ID",
    "message": "={{ $('One item at a time').item.json.text }}",
    "responseType": "customForm",
    "formFields": {
     "values": [
      {
       "fieldLabel": "Decision",
       "fieldType": "dropdown",
       "fieldOptions": {
        "values": [
         {
          "option": "Approve"
         },
         {
          "option": "Edit"
         },
         {
          "option": "Skip"
         }
        ]
       },
       "requiredField": true
      },
      {
       "fieldLabel": "Edits (one per line, platform: new caption)",
       "fieldType": "textarea"
      }
     ]
    },
    "options": {}
   },
   "id": "196563f1-0f3c-4851-81c2-c52ec02e8b83",
   "name": "Ask Tolu",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1320,
    90
   ],
   "webhookId": "d0ee2451-298a-436c-9924-09f1ffbee9e3"
  },
  {
   "parameters": {
    "jsCode": "const item = $('One item at a time').item.json;\nconst d = $json.data || $json;\nconst decision = d['Decision'] || d.decision;\nconst edits = {};\nfor (const line of String(d['Edits (one per line, platform: new caption)'] || '').split('\\n')) {\n  const m = line.match(/^\\s*(facebook|instagram|linkedin|x|tiktok|whatsapp)\\s*:\\s*(.+)$/i);\n  if (m) edits[m[1].toLowerCase()] = m[2].trim();\n}\nreturn item.versions.map(v => {\n  let status = v.status, caption = v.caption;\n  if (decision === 'Skip') status = 'skipped';\n  else if (edits[v.platform]) { caption = edits[v.platform]; status = 'approved'; }\n  else if (v.status === 'awaiting_approval' && (decision === 'Approve' || decision === 'Edit')) status = 'approved';\n  return { json: { post_key: v.post_key, caption, status, approved_by: status === 'approved' ? 'Tolu' : '' } };\n});\n",
    "mode": "runOnceForAllItems"
   },
   "id": "3659936e-835e-483c-b5fa-ddbfebf533ab",
   "name": "Apply decision",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1540,
    90
   ]
  },
