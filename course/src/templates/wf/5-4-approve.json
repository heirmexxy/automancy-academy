      {
       "field": "cronExpression",
       "expression": "0 16 * * 5"
      }
     ]
    }
   },
   "id": "d2c5a6f8-a7de-41d9-af82-eb84d43d3a50",
   "name": "Fridays 16:00",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
