   "id": "15021622-2725-4f99-ac6f-4c720503aa7e",
   "name": "Read Posts",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    220,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const rows = $input.all().map(i => i.json).filter(r => ['awaiting_approval', 'needs_edit'].includes(r.status));\nconst groups = {};\nfor (const r of rows) (groups[r.calendar_id] = groups[r.calendar_id] || []).push(r);\nreturn Object.entries(groups).map(([calendar_id, versions]) => ({ json: {\n  calendar_id, media_file: versions[0].media_file, scheduled_at: versions[0].scheduled_at,\n  versions,\n  text: `${versions[0].scheduled_at} · ${versions[0].pillar}\\n\\n` + versions.map(v =>\n    `[${v.platform}]${v.status === 'needs_edit' ? ' NEEDS EDIT: ' + v.problems : ''}\\n${v.caption}`).join('\\n\\n'),\n} }));\n",
    "mode": "runOnceForAllItems"
   },
   "id": "f4517f1c-125a-400e-8bd1-3a9589156ce6",
   "name": "Group by calendar item",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    0
   ]
  },
  {
   "parameters": {
    "batchSize": 1,
    "options": {}
   },
