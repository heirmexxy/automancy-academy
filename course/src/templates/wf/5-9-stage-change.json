   "parameters": {
    "jsCode": "// Loop guard: react only to the field we need, and ignore changes made by integrations (including ours).\nreturn $input.all().filter(i => i.json.propertyName === 'dealstage'\n  && !['INTEGRATION', 'API'].includes(String(i.json.changeSource || '').toUpperCase()));\n",
    "mode": "runOnceForAllItems"
   },
