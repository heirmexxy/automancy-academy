    {
      "parameters": {
        "jsCode": "const ALLOWED = ['merge_companies', 'bulk_update_property', 'create_task', 'require_field', 'score_weight'];\nconst p = $json;\nconst ids = (Array.isArray(p.target_ids) ? p.target_ids : []).map(String);\nconst objects = ['companies', 'contacts', 'deals'];\nconst forbiddenProp = /^(dealstage|hs_|lifecyclestage|marketing_consent|hubspot_owner_id)/;\nlet ok = ALLOWED.includes(p.action);\nif (p.action === 'merge_companies') ok = ok && ids.length === 2 && !!p.details?.domain;\nif (p.action === 'bulk_update_property') ok = ok && objects.includes(p.details?.object) && !!p.details?.property && !forbiddenProp.test(p.details.property) && ids.length > 0 && ids.length <= 100;\nreturn { json: { ...p, ids, ok } };",
        "mode": "runOnceForEachItem"
      },
