    {
      "parameters": {
        "jsCode": "const p = $('Allow-list check again').item.json;\nconst rows = $json.results || [];\nconst norm = d => String(d || '').toLowerCase().replace(/^www\\./, '');\nconst ok = rows.length === 2 && norm(rows[0].properties.domain) && norm(rows[0].properties.domain) === norm(rows[1].properties.domain) && norm(rows[0].properties.domain) === norm(p.details.domain);\nreturn { json: { id: p.id, ok, before: rows.map(r => ({ id: r.id, ...r.properties })), keep: p.ids[0], merge: p.ids[1] } };",
        "mode": "runOnceForEachItem"
      },
