    {
      "parameters": {
        "jsCode": "// After round 2, whatever the verdict, a draft goes to Tolu. Pick the latest writer and editor.\nconst pairs = [['Writer · revision 2', 'Editor · round 2'], ['Writer · revision 1', 'Editor · round 1'], ['Writer', 'Editor']];\nconst [w, e] = pairs.find(([w]) => $(w).isExecuted);\nconst draft = $(w).first().json.text;\nconst v = $(e).first().json.output ?? $(e).first().json;\nconst week = $('Check research').first().json.research.week;\nconst approved = v.approved === true;\nconst subject = (approved ? '' : '⚠ Needs a human look: ') + `This week at the market (${week})`;\nconst body = approved ? draft : `EDITOR'S ISSUES\\n- ${(v.issues ?? []).join('\\n- ')}\\n\\n----\\n\\n${draft}`;\nreturn [{ json: { subject, body, approved } }];"
      },
