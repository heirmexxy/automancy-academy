    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Collect this week\\'s market facts for the week starting ' + $now.setZone('Africa/Lagos').startOf('week').toISODate() + '. Call both tools.' }}",
        "options": {
          "systemMessage": "Collect facts only. Every price must come from a tool result, with its source. No opinions, no advice.\nUse get_price_history for prices (this week vs last) and get_top_sellers for what customers bought. Return the research in the required shape.",
          "maxIterations": 5
        },
        "hasOutputParser": true
      },
      "id": "dfed7ab8-90fc-4f95-9a35-1e16da8fb2cd",
      "name": "Researcher",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        240,
