      "parameters": {
        "name": "get_price_history",
        "description": "Returns this week's and last week's supplier price for every product, each with its source. Use it for all price facts. No input.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "YOUR_PRICE_HISTORY_WORKFLOW_ID",
          "mode": "id"
        }
      },
      "id": "39d0ed27-3737-4822-92ea-4d632dbccb3c",
      "name": "get_price_history",
