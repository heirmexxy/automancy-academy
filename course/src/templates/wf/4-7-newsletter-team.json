      ]
    },
    {
      "parameters": {
        "name": "get_top_sellers",
        "description": "Returns Harvest Lane's five best-selling products over the last 7 days, with units sold. Use it to know what restaurants are buying. No input.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "YOUR_TOP_SELLERS_WORKFLOW_ID",
          "mode": "id"
        }
      },
      "id": "195878c4-9286-474a-b287-1c04909f826b",
      "name": "get_top_sellers",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1.3,
      "position": [
        360,
        240
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"week\": {\n      \"type\": \"string\",\n      \"description\": \"Monday date, YYYY-MM-DD\"\n    },\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"product\": {\n            \"type\": \"string\"\n          },\n          \"price_now\": {\n            \"type\": \"number\"\n          },\n          \"price_last_week\": {\n            \"type\": \"number\"\n          },\n          \"change_pct\": {\n            \"type\": \"number\"\n          },\n          \"source\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"product\",\n          \"price_now\",\n          \"price_last_week\",\n          \"source\"\n        ]\n      }\n    },\n    \"notes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"week\",\n    \"items\"\n  ]\n}"
      },
      "id": "8f042da2-5aae-4a2b-9380-39032e795050",
      "name": "Research shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        500,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Facts must be right before anyone writes. Code checks the hand-off.\nconst r = $json.output ?? $json;\nconst problems = [];\nconst items = Array.isArray(r.items) ? r.items : [];\nif (!items.length) problems.push('No items in research');\nfor (const it of items) {\n  for (const k of ['price_now', 'price_last_week']) {\n    if (typeof it[k] !== 'number' || !(it[k] > 0)) problems.push(`${it.product ?? '?'}: missing ${k}`);\n  }\n  if (!it.source) problems.push(`${it.product ?? '?'}: missing source`);\n  // Recalculate change_pct in code and overwrite whatever the model wrote.\n  if (it.price_last_week > 0) it.change_pct = Math.round((it.price_now - it.price_last_week) / it.price_last_week * 1000) / 10;\n}\nreturn [{ json: { ok: problems.length === 0, problems, research: { week: r.week, items, notes: r.notes ?? [] } } }];"
      },
