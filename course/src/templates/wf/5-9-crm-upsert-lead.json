    "jsCode": "const d = String($json.phone || '').replace(/\\D/g, '').replace(/^(234|0)/, '');\nreturn { ...$json,\n  email: String($json.email || '').trim().toLowerCase(),\n  phone: d ? '+234' + d : '',\n  domain: String($json.domain || '').trim().toLowerCase().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split('/')[0] };\n",
    "mode": "runOnceForEachItem"
   },
