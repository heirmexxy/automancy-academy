  {
   "parameters": {
    "operation": "executeQuery",
    "query": "update customers set crm_contact_id = $1, crm_deal_id = nullif($2, '') where id = $3;",
    "options": {
     "queryReplacement": "={{ [ String($json.contact_id), String($json.deal_id || ''), $json.customer_id ] }}"
    }
   },
   "id": "e11a34e3-607b-4c26-a1d1-477a0199ee89",
   "name": "6 Save CRM IDs in Supabase",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    3080,
    180
   ]
