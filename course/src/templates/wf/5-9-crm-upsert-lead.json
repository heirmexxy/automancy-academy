  {
   "parameters": {
    "jsCode": "// Code node: weights calibrated in the Card 3 lab against last quarter\nconst W = { type: 20, asked: 25, opens: 5, size: 10 };\nconst L = $json;\nif (L.delivery_zone !== 'in')\n  return { ...L, harvest_score: 0, ready: false, why: 'outside delivery zone' };\nlet s = 30; // in zone\nif (['restaurant','hotel','caterer'].includes(L.business_type)) s += W.type;\nif (L.asked_price_or_tasting) s += W.asked;\nif (L.email_opens >= 3) s += W.opens;\nif (L.staff >= 20) s += W.size;\nreturn { ...L, harvest_score: s, ready: s >= 65 };\n",
    "mode": "runOnceForEachItem"
   },
   "id": "0c52cceb-cffa-4f06-ab23-441ca6d382d2",
