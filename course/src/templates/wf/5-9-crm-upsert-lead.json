  {
   "parameters": {
    "jsCode": "const ids = $('Contact ID').item.json;\nlet deal_id = '';\ntry { deal_id = $('Deal: create at New enquiry').item.json.id || ''; } catch (e) {}\nif (!deal_id) { try { deal_id = $('Open deals for this company').item.json.results?.[0]?.id || ''; } catch (e) {} }\nreturn { ...$('1 Normalise').item.json, contact_id: ids.contact_id, company_id: ids.company_id, deal_id, lifecyclestage: ids.lifecyclestage };\n",
    "mode": "runOnceForEachItem"
   },
