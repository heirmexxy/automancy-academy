    {
      "parameters": {
        "jsCode": "// Small, human-readable result. No phone numbers or addresses.\nconst id = $('Validate order_id').first().json.order_id;\nconst o = $('Find order').all().map(i => i.json).find(r => String(r.order_id).toUpperCase() === id);\nif (!o) return [{ json: { found: false, message: `No order ${id}.` } }];\nconst c = $input.all().map(i => i.json).find(r => String(r.chat_id) === String(o.chat_id)) ?? {};\nlet items;\ntry { items = JSON.parse(o.items_json).map(l => `${l.qty} × ${l.name}`).join(', '); } catch (e) { items = o.items_json; }\nreturn [{ json: { found: true, order_id: o.order_id, customer_first_name: String(c.name ?? '').split(' ')[0] || 'unknown',\n  items, total_naira: Number(o.total), status: o.status, delivery_date: o.delivery_date, rider: o.rider || 'not assigned' } }];"
      },
