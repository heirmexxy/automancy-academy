   "id": "0a2e583d-7277-4935-bdc9-0fb859e0fb42",
   "name": "Read Prospects",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    440,
    0
   ],
   "executeOnce": true
  },
  {
   "parameters": {
    "jsCode": "const cfg = $('Config').first().json;\nconst rows = $input.all().map(i => i.json);\nconst today = new Date().toISOString().slice(0, 10);\nconst sentToday = rows.filter(r => String(r.sent_at).startsWith(today) || String(r.followup_sent_at).startsWith(today)).length;\nlet remaining = Math.max(0, cfg.daily_cap - sentToday);\n// working days between two dates\nconst workingDaysSince = (iso) => {\n  let d = new Date(iso), n = 0; const now = new Date();\n  while (d < now) { d.setDate(d.getDate() + 1); const wd = d.getDay(); if (d <= now && wd !== 0 && wd !== 6) n++; }\n  return n;\n};\nconst firsts = rows.filter(r => r.status === 'approved' && !r.sent_at && r.business_email)\n  .map(r => ({ ...r, kind: 'first', send_subject: r.subject, send_body: r.draft }));\nconst followups = rows.filter(r => r.status === 'sent' && r.sent_at && !r.followup_sent_at && !r.reply_type\n    && workingDaysSince(r.sent_at) >= 5)\n  .map(r => ({ ...r, kind: 'follow-up', send_subject: 'Re: ' + r.subject,\n    send_body: 'Hi again,\\n\\nJust checking whether a free sample crate of tomatoes, peppers and greens would be useful for your kitchen. If not, no problem at all.\\n\\nTolu Adebayo\\nHarvest Lane, Bodija, Ibadan\\n\\nNot interested? Reply STOP and we will never email you again.' }));\nconst picked = [...firsts, ...followups].slice(0, remaining);\nreturn picked.map(r => ({ json: { ...r, business_email: String(r.business_email).trim().toLowerCase() } }));\n",
    "mode": "runOnceForAllItems"
   },
