       "value": 20,
       "type": "number"
      }
     ]
    },
    "options": {}
   },
   "id": "a906ad43-b97c-453d-adb2-d9528d23b6bb",
   "name": "Config",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
