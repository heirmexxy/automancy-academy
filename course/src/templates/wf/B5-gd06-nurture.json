    {
      "parameters": {
        "jsCode": "// Blocks any price or discount that isn't on the approved lists (test 12).\nconst inp = $('Inputs and pause switch').first().json;\nconst n = $json.output || $json;\nconst text = [n.preview_text, ...(n.sections || []).flatMap(s => [s.heading, s.body]), ...(n.subject_options || [])].join(' ');\nconst prices = new Set((inp.prices || []).map(p => Number(p.price_ngn)));\nconst offers = (inp.approved_offers || []).join(' ').toLowerCase().replace(/\\s/g, '');\nconst problems = [];\nfor (const m of text.match(/₦\\s?[\\d,]+/g) || []) if (!prices.has(Number(m.replace(/[^\\d]/g, '')))) problems.push('price ' + m + ' is not on the price list');\nfor (const m of text.match(/\\d+\\s?%|\\bfree delivery\\b|\\bdiscount\\b|\\bpromo code\\b/gi) || []) if (!offers.includes(m.toLowerCase().replace(/\\s/g, ''))) problems.push('\"' + m + '\" is not an approved offer');\nconst week = $now.toFormat('W');\nconst html = (n.sections || []).map(s => `<h2>${s.heading}</h2><p>${String(s.body).replace(/\\n/g, '<br>')}</p>`).join('') +\n  '<p style=\"font-size:12px;color:#666\">You get this because you ticked \"Send me weekly prices and offers\" at checkout. <a href=\"' + '{' + '{ unsubscribe }' + '}' + '\">Unsubscribe</a></p>';\nreturn [{ json: { ok: problems.length === 0, problems, subject: (n.subject_options || [])[0] || 'This week at Harvest Lane',\n  subject_options: n.subject_options || [], preview: n.preview_text || '', html: html.replace(/utm_campaign=weekNN/g, 'utm_campaign=week' + week), week } }];"
      },
