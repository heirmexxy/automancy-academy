    {
      "parameters": {
        "jsCode": "const c = ($json.campaigns || [])[0];\nif (!c) return [];\nconst g = c.statistics?.globalStats || {};\nconst delivered = Number(g.delivered || 0);\nconst rate = delivered ? Number(g.complaints || 0) / delivered : 0;\nreturn [{ json: { campaign: c.id, name: c.name, delivered, clicks: Number(g.uniqueClicks || 0), complaints: Number(g.complaints || 0),\n  unsubscribes: Number(g.unsubscriptions || 0), complaint_rate: rate, pause: rate > 0.001 } }];"
      },
