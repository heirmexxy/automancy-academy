      "id": "25e99849-c931-4320-bacb-4ea380a26cdf",
      "name": "Newsletter JSON",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        880,
        -18
