        "jsonSchemaExample": "{\n  \"subject_options\": [\n    \"...\",\n    \"...\",\n    \"...\"\n  ],\n  \"preview_text\": \"...\",\n  \"sections\": [\n    {\n      \"heading\": \"...\",\n      \"body\": \"...\"\n    }\n  ]\n}"
