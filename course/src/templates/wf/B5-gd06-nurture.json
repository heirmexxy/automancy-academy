    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.customer_id, i.value AS email, c.first_name, c.segment, c.fav_category, c.usual_order_day,\n       (SELECT max(paid_at)::date FROM orders o WHERE o.customer_id = c.customer_id) AS last_order_date\nFROM customers c JOIN identities i ON i.customer_id = c.customer_id AND i.type = 'email' AND i.verified\nWHERE c.marketing_consent = true AND c.consent_at IS NOT NULL\n  AND NOT EXISTS (SELECT 1 FROM suppression s WHERE s.value = i.value)\n  AND (c.brevo_synced_at IS NULL OR c.brevo_synced_at < (SELECT max(paid_at) FROM orders o WHERE o.customer_id = c.customer_id))\nLIMIT 200;",
        "options": {}
      },
