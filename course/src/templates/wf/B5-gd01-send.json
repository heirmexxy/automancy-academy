      ],
      "webhookId": "d6ad7b14-78cc-40b2-9921-e97347208cf5"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO events (workflow, lead_id, event, detail) VALUES ('GD·01', $1, 'success', $2::jsonb);",
        "options": {
          "queryReplacement": "={{ [ null, JSON.stringify({ step: 'send' }) ] }}"
        }
      },
      "id": "b48db235-68c4-4eca-9262-734aaeb8d2be",
