    {
      "parameters": {
        "jsCode": "// Who, what, what's been tried; reply time by the hour; storm grouping (curveball 3).\nconst t = $('When Executed by Another Workflow').first().json;\nconst now = $now.setZone('Africa/Lagos');\nconst working = now.weekday <= 6 && now.hour >= 8 && now.hour < 18;\nconst when = working ? 'within 30 minutes' : (now.hour < 8 ? 'by 9 a.m. today' : 'by 9 a.m. tomorrow');\nconst issue = String(t.issue_key || 'other').toLowerCase().trim();\nconst since = now.minus({ minutes: 30 }).toISO();\n// Hand-overs for the same issue in the last 30 minutes, including this one.\nconst recent = $('Recent hand-overs').all().map(i => i.json)\n  .filter(r => r.issue_key === issue && Date.parse(String(r.at)) >= Date.parse(since) && r.session !== `tg-${t.chat_id}`).length + 1;\nconst mode = recent <= 5 ? 'individual' : recent === 6 ? 'group_summary' : 'grouped_silent';\nconst summary = `🙋 Hand-over · ${t.customer_name || 'Customer'} (tg-${t.chat_id}) · ${now.toFormat('HH:mm')}\\n` +\n  `Wants: ${t.wants}\\nTried: ${t.tried}\\nSuggested: ${t.suggested || 'reply ' + when}`;\nconst group = `🌧 ${recent} customers in 30 min, all \"${issue}\". Individual alerts paused for this issue. ` +\n  `Open the Handovers sheet, then approve one honest status message for them all.`;\nreturn [{ json: { session: `tg-${t.chat_id}`, issue_key: issue, summary, group, mode, when,\n  is_eval: String(t.is_eval) === 'true',\n  customer_message: `I've passed this to Tolu with all the details. She'll reply ${when}.` } }];"
      },
