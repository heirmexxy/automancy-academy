    {
      "parameters": {
        "jsCode": "// Today's numbers, Lagos time. Read-only.\nconst today = $now.setZone('Africa/Lagos').toISODate();\nconst orders = $('Read Orders').all().map(i => i.json).filter(o => String(o.created_at).startsWith(today));\nconst paid = orders.filter(o => ['Paid', 'Delivered', 'Out for delivery'].includes(o.status));\nconst lowStock = $('Read Price_List').all().map(i => i.json)\n  .filter(p => p.active !== 'no' && Number(p.stock) < 5)\n  .map(p => `${p.name} (${p.stock} ${p.unit} left)`);\nreturn [{ json: { date: today, orders: orders.length,\n  revenue_naira: paid.reduce((s, o) => s + Number(o.total || 0), 0),\n  pending: orders.filter(o => o.status === 'Pending').length,\n  low_stock_count: lowStock.length, low_stock: lowStock } }];"
      },
      "id": "d5b6cd18-0d6c-4dba-a464-1a955182d9b4",
