    {
      "parameters": {
        "jsCode": "// Hard rules in code: food safety is alerted whatever the AI's confidence.\nconst src = $('New items').item.json;\nconst t = { ...src, ...($json.output || $json) };\nconst hard = t.topic === 'food safety' || /threat|police|lawyer|sick after|food poison|vomit|stomach|hospital/i.test(t.text);\nconst soft = t.sentiment === 'negative' && t.confidence >= 0.8 && ['refund', 'late delivery'].includes(t.topic);\nreturn { json: { ...t, alert: hard || soft, level: hard ? 'now' : soft ? 'today' : 'report' } };",
        "mode": "runOnceForEachItem"
      },
      "id": "a8ae880c-6e7e-495e-9545-3c5642058bef",
      "name": "Alert rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE mentions SET sentiment = $2, topic = $3, urgent = $4, intent = $5, confidence = $6, level = $7\nWHERE item_id = $1 RETURNING item_id, source, link, text, topic, level;",
        "options": {
          "queryReplacement": "={{ [ $json.item_id, $json.sentiment, $json.topic, $json.urgent || $json.level === 'now', $json.intent, $json.confidence, $json.level ] }}"
        }
      },
