      "id": "249b10d5-a3e1-4d81-9ab4-661b6ee639e5",
      "name": "Fixes model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        440,
        990
