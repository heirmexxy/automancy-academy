        "options": {
          "temperature": 0.2
        }
      },
      "id": "5e114098-5e73-4692-abf8-12d8bfa73a2d",
      "name": "Label model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1320,
        180
      ]
