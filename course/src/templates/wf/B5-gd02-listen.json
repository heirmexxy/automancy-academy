    {
      "parameters": {
        "numberInputs": 3
      },
      "id": "a94be330-14e5-4556-8fe3-b27406535ce6",
      "name": "Collect",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        440,
        0
