        "promptType": "define",
        "text": "=Negative comments this week:\n{{ ($json.negatives || []).map(t => '- ' + t).join('\\n') }}",
        "messages": {
          "messageValues": [
            {
              "message": "Suggest three practical fixes for Harvest Lane based only on these comments. For each fix, quote the comment(s) it comes from word for word. Do not invent numbers. Three short bullet points."
