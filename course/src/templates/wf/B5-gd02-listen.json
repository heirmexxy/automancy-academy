    },
    {
      "parameters": {
        "jsCode": "const n = $('Week counts').first().json;\nconst fmt = o => Object.entries(o || {}).map(([k, v]) => `${k} ${v}`).join(' · ') || 'none';\nconst change = Number(n.last_week) ? Math.round(100 * (n.this_week - n.last_week) / n.last_week) : null;\nconst text = `👂 Listening · last 7 days\\nMentions: ${n.this_week}${change === null ? '' : ` (${change >= 0 ? '+' : ''}${change}% vs last week)`}\\nBy source: ${fmt(n.by_source)}\\nSentiment: ${fmt(n.by_sentiment)}\\nNegative topics: ${fmt(n.negative_topics)}\\nUrgent alerts: ${n.urgent}\\n\\nThree fixes:\\n${$json.text}`;\nreturn [{ json: { text } }];"
      },
