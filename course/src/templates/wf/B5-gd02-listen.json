      "id": "3d35163f-2c2d-4777-9b7f-23be5edf3cf1",
      "name": "Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        810
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT json_object_agg(source, n) FROM (SELECT source, count(*) n FROM mentions WHERE created_at > now() - interval '7 days' GROUP BY 1) a) AS by_source,\n  (SELECT json_object_agg(sentiment, n) FROM (SELECT sentiment, count(*) n FROM mentions WHERE created_at > now() - interval '7 days' GROUP BY 1) a) AS by_sentiment,\n  (SELECT json_object_agg(topic, n) FROM (SELECT topic, count(*) n FROM mentions WHERE created_at > now() - interval '7 days' AND sentiment = 'negative' GROUP BY 1) a) AS negative_topics,\n  (SELECT count(*) FROM mentions WHERE created_at > now() - interval '7 days') AS this_week,\n  (SELECT count(*) FROM mentions WHERE created_at BETWEEN now() - interval '14 days' AND now() - interval '7 days') AS last_week,\n  (SELECT count(*) FROM mentions WHERE created_at > now() - interval '7 days' AND level = 'now') AS urgent,\n  (SELECT json_agg(text) FROM (SELECT text FROM mentions WHERE created_at > now() - interval '7 days' AND sentiment = 'negative' ORDER BY created_at DESC LIMIT 15) t) AS negatives;",
        "options": {}
      },
      "id": "26b1aede-e3f5-4108-adcb-b6395483fbb6",
      "name": "Week counts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
