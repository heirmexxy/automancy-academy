        "query": "WITH p AS (\n  INSERT INTO settings (key, value) VALUES ('posting_paused', 'true'), ('outreach_paused', 'true')\n  ON CONFLICT (key) DO UPDATE SET value = 'true' RETURNING key\n)\nINSERT INTO events (workflow, event, detail)\nSELECT 'GD·02', 'storm', jsonb_build_object('topic', $1, 'count', $2::int, 'paused', (SELECT count(*) FROM p));",
