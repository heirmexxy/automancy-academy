    {
      "parameters": {
        "jsCode": "const out = [];\nconst fb = $('Facebook comments').first().json.data || [];\nfor (const post of fb) for (const c of (post.comments?.data || []))\n  out.push({ source: 'facebook', item_id: 'fb_' + c.id, link: c.permalink_url || post.permalink_url, posted_at: c.created_time, text: c.message || '' });\nconst ig = $('Instagram comments').first().json.data || [];\nfor (const m of ig) for (const c of (m.comments?.data || []))\n  out.push({ source: 'instagram', item_id: 'ig_' + c.id, link: m.permalink, posted_at: c.timestamp, text: c.text || '' });\nconst xml = String($('Web mentions (RSS)').first().json.xml || '');\nfor (const block of xml.split(/<item>|<entry>/).slice(1)) {\n  const tag = t => (block.match(new RegExp('<' + t + '[^>]*>([\\\\s\\\\S]*?)</' + t + '>')) || [])[1] || '';\n  const link = tag('link') || (block.match(/<link[^>]*href=\"([^\"]+)\"/) || [])[1] || '';\n  const text = (tag('title') + ' ' + tag('description')).replace(/<!\\[CDATA\\[|\\]\\]>/g, '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n  out.push({ source: 'web', item_id: 'web_' + (tag('guid') || link), link, posted_at: tag('pubDate') || tag('published') || new Date().toISOString(), text });\n}\nreturn out.filter(o => o.text).map(json => ({ json }));"
      },
      "id": "cb7cfb08-ca8e-4b50-bd71-7469b6649be8",
