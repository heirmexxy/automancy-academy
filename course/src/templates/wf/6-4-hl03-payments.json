    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH paid AS (\n  UPDATE orders SET status = 'paid', paid_at = now(), paystack_ref = $2\n  WHERE order_id = $1 AND status = 'quoted'\n  RETURNING order_id, items\n), stock_down AS (\n  UPDATE stock s SET qty = s.qty - (i->>'quantity')::int\n  FROM paid, jsonb_array_elements(paid.items) AS i\n  WHERE s.sku = i->>'sku'\n  RETURNING s.sku\n), ev AS (\n  INSERT INTO events (workflow, order_id, event, detail)\n  SELECT 'HL·03', order_id, 'paid', jsonb_build_object('amount', $3::int, 'reference', $2) FROM paid\n)\nSELECT order_id, (SELECT count(*) FROM stock_down) AS stock_lines FROM paid;",
        "options": {
          "queryReplacement": "={{ [ $json.order_id, $json.reference, $json.amount_ngn ] }}"
        }
      },
