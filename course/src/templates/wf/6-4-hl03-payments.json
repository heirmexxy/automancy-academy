    {
      "parameters": {
        "jsCode": "const v = $('Verify transaction').first().json.data || {};\nconst o = $input.first().json;\nconst ok = v.status === 'success' && !!o.order_id && v.currency === 'NGN' && v.amount === Number(o.total_ngn) * 100;\nreturn [{ json: {\n  ok, order_id: o.order_id || v.metadata?.order_id || null, reference: v.reference || $('Verify signature').first().json.reference,\n  amount_ngn: (v.amount || 0) / 100, expected_ngn: Number(o.total_ngn || 0),\n  why: v.status !== 'success' ? 'Paystack says ' + (v.status || 'no such transaction') : !o.order_id ? 'order not found' : ok ? 'ok' : 'wrong amount'\n} }];"
      },
