    {
      "parameters": {
        "name": "get_price",
        "description": "Looks up today's official Harvest Lane price and stock for one product. Use this whenever a customer asks about a price, a total or availability, before giving any number. Returns found (true/false), name, unit, price in naira and stock. If found is false, ask the customer which product they mean. Don't use it for delivery fees; those are fixed in your instructions.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "YOUR_GET_PRICE_WORKFLOW_ID",
          "mode": "id"
        },
        "specifyInputSchema": true,
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"product\": {\n      \"type\": \"string\",\n      \"description\": \"the product as the customer wrote it, one product per call, e.g. tatashe, ugu, ata rodo\"\n    }\n  },\n  \"required\": [\n    \"product\"\n  ]\n}"
      },
