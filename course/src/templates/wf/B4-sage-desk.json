    {
      "parameters": {
        "jsCode": "// Sanitise before memory or the model ever sees it: mask card-like numbers and codes.\nlet text = String($json.text ?? '');\nconst before = text;\ntext = text.replace(/\\b(?:\\d[ -]?){12,19}\\b/g, '[card number removed]');\ntext = text.replace(/\\b(pin|otp|cvv|password)\\b\\s*[:=]?\\s*\\S+/gi, '$1 [removed]');\nreturn { json: { ...$json, text, masked: text !== before } };",
        "mode": "runOnceForEachItem"
      },
      "id": "761ebfc3-45be-4a69-925b-28f68e8332c3",
