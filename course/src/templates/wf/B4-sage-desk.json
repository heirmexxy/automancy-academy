        "name": "handover_to_tolu",
        "description": "Hands this conversation to Tolu, a person. Use if the customer asks for a person, is very upset, you've failed twice, or the request is outside your tools. Sends Tolu a short summary and pauses you for this customer. Returns customer_message: say it to the customer exactly.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "YOUR_HANDOVER_WORKFLOW_ID",
          "mode": "id"
        },
        "fields": {
          "values": [
            {
              "name": "chat_id",
              "stringValue": "={{ $('Mask card numbers').item.json.chat_id }}"
            },
            {
              "name": "customer_name",
              "stringValue": "={{ $('Mask card numbers').item.json.first_name }}"
            },
            {
              "name": "is_eval",
              "stringValue": "={{ $('Mask card numbers').item.json.is_eval }}"
            }
          ]
        },
        "specifyInputSchema": true,
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"wants\": {\n      \"type\": \"string\",\n      \"description\": \"What the customer wants, one line, e.g. refund for HL-0398, 3rd late delivery, very upset\"\n    },\n    \"tried\": {\n      \"type\": \"string\",\n      \"description\": \"What you have tried so far, one line\"\n    },\n    \"suggested\": {\n      \"type\": \"string\",\n      \"description\": \"Suggested next step for Tolu, one line\"\n    },\n    \"issue_key\": {\n      \"type\": \"string\",\n      \"description\": \"Short issue label in lower case, e.g. late delivery, damaged goods, wrong item, other\"\n    }\n  },\n  \"required\": [\n    \"wants\",\n    \"tried\",\n    \"issue_key\"\n  ]\n}"
      },
