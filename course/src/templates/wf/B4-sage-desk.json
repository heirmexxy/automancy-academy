        "specifyInputSchema": true,
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"order_id\": {\n      \"type\": \"string\",\n      \"description\": \"Order number, format HL-0000\"\n    },\n    \"amount\": {\n      \"type\": \"number\",\n      \"description\": \"Refund amount in naira, e.g. 4800\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence: what went wrong and the policy section that supports the refund\"\n    }\n  },\n  \"required\": [\n    \"order_id\",\n    \"amount\",\n    \"reason\"\n  ]\n}"
      },
