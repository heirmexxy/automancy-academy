       "value": "displayName"
      }
     ]
    },
    "options": {}
   },
   "id": "b2f8649f-6535-4ea7-a402-bfa72e67ed89",
   "name": "Fresh place details",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    660,
    90
   ]
  },
  {
   "parameters": {
    "operation": "sendAndWait",
    "chatId": "YOUR_TELEGRAM_CHAT_ID",
    "message": "=Outreach draft for {{ $json.displayName.text }}\nFit score: {{ $('One prospect at a time').item.json.fit_score }}\nWhy: {{ $('One prospect at a time').item.json.reasons }}\nFact: {{ $('One prospect at a time').item.json.fact || 'none (general line used)' }}\nSource: {{ $('One prospect at a time').item.json.fact_source || '-' }}\nTo: {{ $('One prospect at a time').item.json.business_email }}\n\nSubject: {{ $('One prospect at a time').item.json.subject }}\n\n{{ $('One prospect at a time').item.json.draft }}",
    "responseType": "customForm",
    "formFields": {
     "values": [
      {
       "fieldLabel": "Decision",
       "fieldType": "dropdown",
       "fieldOptions": {
        "values": [
         {
          "option": "Approve"
         },
         {
          "option": "Edit"
         },
         {
          "option": "Skip"
         }
        ]
       },
       "requiredField": true
      },
      {
       "fieldLabel": "Edited draft (only if Edit)",
       "fieldType": "textarea"
      }
     ]
    },
    "options": {}
   },
   "id": "8649b556-c486-4da6-ba30-5f990afb47fa",
   "name": "Ask Tolu",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    880,
    90
   ],
   "webhookId": "c5ad41d1-a64a-49a7-98ba-ff1bbff24bd4"
  },
  {
   "parameters": {
    "jsCode": "const p = $('One prospect at a time').item.json;\nconst d = $json.data || $json;\nconst decision = d['Decision'] || d.decision;\nconst edited = String(d['Edited draft (only if Edit)'] || '').trim();\nconst optOut = 'Not interested? Reply STOP and we will never email you again.';\nlet draft = p.draft;\nif (decision === 'Edit' && edited) {\n  draft = edited.includes('Reply STOP') ? edited\n    : edited + '\\n\\nTolu Adebayo\\nHarvest Lane, Bodija, Ibadan\\n\\n' + optOut;\n}\nconst approved = decision === 'Approve' || (decision === 'Edit' && edited);\nreturn { place_id: p.place_id, draft, status: approved ? 'approved' : 'skipped', approved_at: approved ? new Date().toISOString() : '' };\n",
    "mode": "runOnceForEachItem"
   },
   "id": "3cededc2-a88d-46e6-b197-323ad89f160e",
   "name": "Apply decision",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1100,
    90
   ]
  },
  {
   "parameters": {
