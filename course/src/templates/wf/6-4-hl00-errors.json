    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO events (workflow, order_id, event, detail) VALUES ('HL·00', $1, 'error', $2::jsonb);",
        "options": {
          "queryReplacement": "={{ [ $('Merge alert').item.json.order_id || $('Last order_id in that workflow').item.json.order_id || null, JSON.stringify({ workflow: $('Merge alert').item.json.workflow, node: $('Merge alert').item.json.node, platform: $('Merge alert').item.json.platform, message: $('Merge alert').item.json.message, url: $('Merge alert').item.json.url }) ] }}"
        }
