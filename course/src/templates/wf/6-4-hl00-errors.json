              "value": "={{ $json.workflow?.name ?? 'Unknown workflow' }}",
              "type": "string"
            },
            {
              "id": "9ca9d0c4-a3db-4605-b4e4-377c5499fde2",
              "name": "node",
              "value": "={{ $json.execution?.lastNodeExecuted ?? 'trigger' }}",
              "type": "string"
            },
            {
              "id": "3a6e8b98-35e8-423f-a6f9-a14ca029ef00",
              "name": "message",
              "value": "={{ $json.execution?.error?.message ?? $json.trigger?.error?.message ?? 'No message' }}",
              "type": "string"
            },
            {
              "id": "981f7e16-d162-486d-840b-caee16e7a7af",
              "name": "url",
              "value": "={{ $json.execution?.url ?? '' }}",
              "type": "string"
            },
            {
              "id": "0718c5de-e1e3-4eda-9177-e0adb51ace65",
              "name": "time",
              "value": "={{ $now.toFormat('ccc d LLL, HH:mm') }}",
              "type": "string"
            },
            {
              "id": "21bfde14-1671-4dd5-80f1-cdf61a077cc6",
              "name": "platform",
              "value": "n8n",
              "type": "string"
            },
            {
              "id": "2854e93f-2bf6-4b46-811d-d52ec10e27e5",
              "name": "order_id",
              "value": "={{ (($json.execution?.error?.message ?? '') + ' ' + ($json.execution?.error?.description ?? '')).match(/HL-\\d{3,}/)?.[0] ?? '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
