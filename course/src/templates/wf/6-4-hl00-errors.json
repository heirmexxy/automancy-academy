      "id": "7f1db49a-e736-4f19-aa3c-3ebfe79eb2c0",
      "name": "Format edge error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        360
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT order_id FROM events\nWHERE workflow = $1 AND order_id IS NOT NULL AND at > now() - interval '15 minutes'\nORDER BY at DESC LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.workflow.split(' ')[0] ] }}"
        }
      },
      "id": "64563a23-0233-490e-84d1-633484329c83",
      "name": "Last order_id in that workflow",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=🚨 {{ $('Merge alert').item.json.workflow }} failed ({{ $('Merge alert').item.json.platform }})\nNode: {{ $('Merge alert').item.json.node }}\nOrder: {{ $('Merge alert').item.json.order_id || $json.order_id || 'none' }}\nError: {{ $('Merge alert').item.json.message }}\nWhen: {{ $('Merge alert').item.json.time }}\nOpen: {{ $('Merge alert').item.json.url }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
