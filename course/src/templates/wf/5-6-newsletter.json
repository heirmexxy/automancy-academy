  {
   "parameters": {
    "jsCode": "const d = $('Check prices and offers').first().json;\nconst cfg = $('Config').first().json;\nconst choice = Number(($json.data || $json).Subject || 1) - 1;\nconst week = 'week' + Math.ceil((((new Date() - new Date(new Date().getFullYear(), 0, 1)) / 864e5) + 1) / 7);\nconst link = `${cfg.order_link}${cfg.order_link.includes('?') ? '&' : '?'}utm_source=email&utm_medium=newsletter&utm_campaign=${week}`;\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\\n/g, '<br>');\nconst unsubscribe = '{' + '{ unsubscribe }' + '}'; // Brevo's unsubscribe tag, built in pieces\nconst html = `<html><body style=\"font-family:Arial,sans-serif;max-width:600px;margin:auto\">\n${d.sections.map(s => `<h2>${esc(s.heading)}</h2><p>${esc(s.body)}</p>`).join('\\n')}\n<p><a href=\"${link}\">Order for tomorrow morning</a></p>\n<p style=\"font-size:12px;color:#666\">Harvest Lane, Bodija, Ibadan. You get this because you ticked \"Send me weekly prices and offers\".\n<a href=\"${unsubscribe}\">Unsubscribe</a> in one tap.</p></body></html>`;\nreturn [{ json: { name: `Newsletter ${week}`, subject: d.subject_options[choice], preview_text: d.preview_text, html,\n  list_id: Number(cfg.test_mode ? cfg.test_list_id : cfg.list_id) } }];\n",
    "mode": "runOnceForAllItems"
   },
