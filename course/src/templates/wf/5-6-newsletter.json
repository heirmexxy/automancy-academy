  {
   "parameters": {
    "jsCode": "const rows = (n) => $(n).all().map(i => i.json).filter(r => Object.keys(r).length);\nconst prices = rows('Read Price list');\nreturn [{ json: {\n  prices: prices.map(p => `${p.product}: ₦${p.price}`),\n  season: rows('Read In season').map(s => `${s.item}${s.note ? ' (' + s.note + ')' : ''}`),\n  story: (rows('Read Customer stories')[0] || {}).story || '',\n  offers: rows('Read Approved offers').map(o => o.offer),\n} }];\n",
    "mode": "runOnceForAllItems"
   },
   "id": "d60afeef-3ca3-4ee0-896b-be35699459c1",
   "name": "Facts",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1320,
    0
   ],
   "executeOnce": true
  },
  {
   "parameters": {
    "promptType": "define",
    "text": "=Prices this week:\n{{ $json.prices.join('\\n') }}\n\nIn season:\n{{ $json.season.join('\\n') }}\n\nApproved customer story:\n{{ $json.story || 'none this week' }}\n\nApproved offers (the only offers allowed):\n{{ $json.offers.join('\\n') || 'none' }}",
    "messages": {
     "messageValues": [
      {
       "message": "You write Harvest Lane's weekly newsletter for customers who asked for weekly prices and offers. Sections: what's in season, this week's prices, one kitchen tip, one customer story (only the approved one). Use only the prices and offers given, written exactly as given. Never invent a discount, offer, promise or claim. Warm, short, plain English. Return subject_options (exactly 3, under 50 characters), preview_text, and sections (heading, body)."
      }
     ]
    }
   },
   "id": "1098f769-0775-407e-aea6-94a5fe626868",
   "name": "Draft newsletter",
   "type": "@n8n/n8n-nodes-langchain.chainLlm",
   "typeVersion": 1.5,
   "position": [
    1540,
    0
   ]
  },
  {
   "parameters": {
    "model": "YOUR_MODEL",
    "options": {}
   },
   "id": "e30fc406-e21a-42d8-ade5-ce85c0eb034d",
   "name": "OpenAI Chat Model",
   "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
   "typeVersion": 1,
   "position": [
    1540,
    216
   ]
  },
  {
   "parameters": {
    "schemaType": "manual",
    "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"subject_options\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 3,\n      \"maxItems\": 3\n    },\n    \"preview_text\": {\n      \"type\": \"string\"\n    },\n    \"sections\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"heading\": {\n            \"type\": \"string\"\n          },\n          \"body\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"heading\",\n          \"body\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"subject_options\",\n    \"preview_text\",\n    \"sections\"\n  ]\n}"
   },
   "id": "a04c8605-0f99-41f2-959b-4d162c8e9b67",
   "name": "Newsletter format",
   "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
   "typeVersion": 1.2,
   "position": [
    1760,
    216
   ]
  },
  {
   "parameters": {
    "jsCode": "// Blocks any price, discount or offer that isn't in the sheets.\nconst f = $('Facts').first().json;\nconst o = $json.output;\nconst text = [...o.subject_options, o.preview_text, ...o.sections.map(s => s.heading + ' ' + s.body)].join('\\n');\nconst allowedAmounts = new Set(f.prices.map(p => (p.match(/₦\\s?([\\d,]+)/) || [, ''])[1].replace(/,/g, '')).filter(Boolean));\nconst offersText = f.offers.join(' ').toLowerCase();\nconst problems = [];\nfor (const a of text.match(/₦\\s?[\\d,]+/g) || []) {\n  const n = a.replace(/[^\\d]/g, '');\n  if (!allowedAmounts.has(n) && !offersText.includes(n)) problems.push(`price ${a} is not in the price list`);\n}\nfor (const p of text.match(/\\d+\\s?%/g) || []) if (!offersText.includes(p.replace(/\\s/g, ''))) problems.push(`discount ${p} is not an approved offer`);\nif (/\\b(discount|% off|buy one get one|free delivery)\\b/i.test(text) && !f.offers.length) problems.push('mentions an offer but no offer is approved');\nreturn [{ json: { ...o, problems, passes: problems.length === 0 } }];\n",
    "mode": "runOnceForAllItems"
   },
