      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1700,
        240
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"tone_ok\": {\n      \"type\": \"boolean\"\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"tone_ok\",\n    \"reason\"\n  ]\n}"
      },
      "id": "7f67de5f-14c7-4054-8a3a-2b83acfa8a58",
      "name": "Judge verdict",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1860,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Tone cases: the code checks AND the judge's yes/no must both pass.\nconst s = $('Score case').item.json;\nconst v = $json.output ?? $json;\nreturn { json: { ...s, pass: s.pass && v.tone_ok === true, notes: 'judge: ' + (v.reason ?? '') } };",
        "mode": "runOnceForEachItem"
      },
