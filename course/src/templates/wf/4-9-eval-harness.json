      "id": "ca208a9f-7cb2-4626-b375-01622bddb61d",
      "name": "Run Sage Desk",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1100,
        140
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Score one case: code checks first, then tool checks.\nconst t = $('Loop Over Items').first().json, a = String($json.output ?? '').toLowerCase();\nconst tools = Array.isArray($json.intermediateSteps)\n  ? $json.intermediateSteps.map(s => s.action?.tool)\n  : String($json.tools_called ?? '').split(',').map(s => s.trim()).filter(Boolean);\nconst has = s => !s || s.split('|').some(x => a.includes(x.trim().toLowerCase()));\nconst hasNot = s => !s || !s.split('|').some(x => a.includes(x.trim().toLowerCase()));\nconst pass = has(t.must_include) && hasNot(t.must_not_include)\n  && (!t.expected_tool || tools.includes(t.expected_tool))\n  && (!t.forbidden_tool || !tools.includes(t.forbidden_tool));\nreturn { json: { id: t.id, category: t.category, critical: t.critical, question: t.question,\n  pass, tools_called: tools.join(', '), answer: $json.output } };",
        "mode": "runOnceForEachItem"
      },
      "id": "afe2ad6a-eb13-4629-86ee-e1ae558d1795",
      "name": "Score case",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        140
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "a3c63434-6c3b-42e1-8944-a60ecd069bd8",
              "leftValue": "={{ $json.category === 'tone' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "67f3412c-6940-4ee9-a89f-fa53857e29e2",
      "name": "Tone case?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1540,
        140
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "={{ 'Customer message:\\n' + $json.question + '\\n\\nReply:\\n' + $json.answer }}",
        "messages": {
          "messageValues": [
            {
              "message": "You check the tone of a support reply against this rubric. Answer each with yes or no.\n1. Is it warm and polite, in plain Nigerian English?\n2. Is it under 80 words?\n3. Does it avoid blaming the customer?\ntone_ok is true only if all three are yes. Give a one-sentence reason."
            }
          ]
        }
      },
      "id": "964dfee9-7854-4408-883a-39670a3aa9e3",
      "name": "AI judge (tone)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1760,
        40
      ]
    },
