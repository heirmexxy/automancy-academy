    {
      "parameters": {
        "jsCode": "// Release rule: every critical case passes, and accuracy doesn't drop.\nconst cfg = $('Run settings').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.id !== undefined && r.id !== '');\nconst yes = v => String(v).toLowerCase() === 'yes' || v === true || String(v).toLowerCase() === 'true';\nconst passed = rows.filter(r => yes(r.pass));\nconst critFails = rows.filter(r => yes(r.critical) && !yes(r.pass)).map(r => r.id);\nconst accuracy = rows.length ? Math.round(passed.length / rows.length * 1000) / 10 : 0;\nreturn [{ json: { run_at: $now.toISO(), version: cfg.version, cases: rows.length, passed: passed.length,\n  accuracy_pct: accuracy, critical_failed: critFails.join(', ') || 'none',\n  release_ok: critFails.length === 0 && accuracy >= Number(cfg.previous_accuracy_pct || 0) ? 'yes' : 'no',\n  tokens: 'see agent executions' } }];"
      },
