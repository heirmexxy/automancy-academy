    "jsCode": "const s = Object.fromEntries($input.all().map(i => [String(i.json.setting).trim(), String(i.json.value).trim()]));\nreturn [{ json: { posting_paused: s.posting_paused === 'true' || s.posting_paused === 'yes', x_monthly_budget_usd: Number(s.x_monthly_budget_usd || 5) } }];\n",
