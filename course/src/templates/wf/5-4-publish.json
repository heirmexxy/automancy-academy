   "id": "66a46ac0-f7ff-4a5c-b0ed-081a7e877ada",
   "name": "Read Price list",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    1100,
    54
   ],
   "executeOnce": true,
   "alwaysOutputData": true
