  {
   "parameters": {
    "jsCode": "const now = new Date();\nconst budget = $('Settings').first().json.x_monthly_budget_usd;\nconst posts = $('Read Posts').all().map(i => i.json);\nconst prices = $('Read Price list').all().map(i => i.json);\nconst month = now.toISOString().slice(0, 7);\nconst xCost = (p) => /https?:\\/\\//.test(p.caption) ? 0.20 : 0.015;   // check X's current pricing\nlet xSpent = posts.filter(p => p.platform === 'x' && String(p.published_at).startsWith(month)).reduce((a, p) => a + xCost(p), 0);\nconst out = [];\nfor (const p of posts) {\n  if (p.status !== 'approved' || p.post_id || new Date(p.scheduled_at) > now) continue;\n  let hold = '';\n  if (String(p.uses_price) === 'true') {\n    const cur = prices.find(r => String(r.product).toLowerCase() === String(p.product).toLowerCase());\n    if (!cur || String(cur.price).replace(/[^\\d]/g, '') !== String(p.price_used).replace(/[^\\d]/g, '')) hold = `price changed (approved ₦${p.price_used}, now ₦${cur ? cur.price : 'missing'})`;\n  }\n  if (!hold && p.platform === 'x') {\n    if (xSpent + xCost(p) > budget) hold = `X monthly budget ($${budget}) reached`;\n    else xSpent += xCost(p);\n  }\n  out.push({ json: { ...p, route: hold ? 'hold' : 'publish', hold_reason: hold } });\n}\nreturn out;\n",
    "mode": "runOnceForAllItems"
   },
