      "id": "c39ce050-cf3b-46da-9f7b-717a97fe0fa0",
      "name": "Download policy text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// One item per policy section, so every chunk carries its section name in metadata.\nconst text = String($input.first().json.data ?? $input.first().json ?? '');\nconst parts = text.split(/\\n(?=##\\s)/).map(s => s.trim()).filter(Boolean);\nreturn parts.map(p => {\n  const [head, ...rest] = p.split('\\n');\n  return { json: { section: head.replace(/^#+\\s*/, '').trim(), text: p } };\n});"
      },
      "id": "1b9a7fbd-7ad4-4bd2-ae4a-31f777952fdf",
      "name": "Split into sections",
