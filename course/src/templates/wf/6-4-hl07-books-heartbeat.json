        "jsCode": "const j = $input.first().json;\nconst b = j.body || {};\nconst secretOk = !!$env.HL_EDGE_SECRET && (j.headers || {})['x-hl-secret'] === $env.HL_EDGE_SECRET;\nconst shapeOk = b.workflow === 'HL·07' && Number.isInteger(b.entries) && b.entries >= 0 && /^\\d{4}-\\d{2}-\\d{2}$/.test(String(b.period || ''));\nreturn [{ json: { ok: secretOk && shapeOk, why: !secretOk ? 'bad secret' : !shapeOk ? 'bad shape' : 'ok', entries: b.entries, period: b.period } }];"
      },
