        "toolDescription": "Propose ONE change for Tolu to approve. It only saves the proposal; it changes nothing in the CRM. action must be one of merge_companies, bulk_update_property, create_task, require_field, score_weight.",
        "method": "POST",
        "url": "https://YOUR_SUPABASE_PROJECT.supabase.co/rest/v1/crm_proposals",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"action\": \"{action}\", \"target_ids\": {target_ids}, \"details\": {details}, \"evidence\": \"{evidence}\", \"expected_effect\": \"{expected_effect}\", \"reversible\": {reversible}}",
        "placeholderDefinitions": {
