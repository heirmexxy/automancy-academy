    {
      "parameters": {
        "jsCode": "// Code, not the agent, decides what may even be shown to Tolu.\nconst ALLOWED = ['merge_companies', 'bulk_update_property', 'create_task', 'require_field', 'score_weight'];\nconst FORBIDDEN = /delete|dealstage|stage|message|whatsapp|email blast|permission|consent/i;\nreturn $input.all().filter(i => i.json.id).map(i => {\n  const p = i.json;\n  const det = JSON.stringify(p.details || {});\n  let ok = ALLOWED.includes(p.action) && !(p.action === 'bulk_update_property' && FORBIDDEN.test(det));\n  if (p.action === 'merge_companies' && !(p.details && p.details.domain)) ok = false;   // merges need a shared verified domain\n  return { json: { ...p, allowed: ok } };\n});"
      },
      "id": "d46bdaaa-fb76-497c-9876-228eef276c5a",
      "name": "Allow-list check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE crm_proposals SET status = CASE WHEN $2 THEN 'awaiting_tolu' ELSE 'rejected_by_code' END WHERE id = $1\nRETURNING id, action, target_ids, details, evidence, expected_effect, reversible, status;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.allowed ] }}"
        }
      },
      "id": "db335d87-af87-48ff-ba12-0dcd964296d5",
      "name": "Save code verdict",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "5f4c4e9f-e466-4cea-9263-9edadac4f779",
              "leftValue": "={{ $json.status }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "awaiting_tolu"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
