        "query": "SELECT coalesce(json_agg(json_build_object('action', action, 'targets', target_ids, 'expected', expected_effect, 'result', result)), '[]'::json) AS last_week\nFROM crm_proposals WHERE status = 'executed' AND executed_at > now() - interval '7 days';",
        "options": {}
      },
