  {
   "parameters": {
    "jsCode": "// One row per comment or message: platform, kind, item_id, thread_id, author_handle, text, received_at, last_customer_msg_at\nconst body = JSON.parse($('Signature valid?').first().json.raw);\nconst now = new Date().toISOString();\nconst platform = body.object === 'instagram' ? 'instagram' : 'facebook';\nconst out = [];\nfor (const entry of body.entry || []) {\n  for (const ch of entry.changes || []) {\n    const v = ch.value || {};\n    if (v.from && v.from.id === entry.id) continue; // our own replies\n    if (platform === 'facebook' && ch.field === 'feed' && v.item === 'comment' && v.verb === 'add') {\n      out.push({ platform, kind: 'comment', item_id: v.comment_id, thread_id: v.post_id, author_handle: v.from?.name || '',\n        text: v.message || '', source_link: v.post?.permalink_url || '',\n        received_at: v.created_time ? new Date(v.created_time * 1000).toISOString() : now });\n    }\n    if (platform === 'instagram' && ch.field === 'comments') {\n      out.push({ platform, kind: 'comment', item_id: v.id, thread_id: v.media?.id || '', author_handle: v.from?.username || '',\n        text: v.text || '', source_link: '', received_at: now });\n    }\n  }\n  for (const m of entry.messaging || []) {\n    if (!m.message || m.message.is_echo) continue;\n    out.push({ platform, kind: 'dm', item_id: m.message.mid, thread_id: m.sender.id, author_handle: m.sender.id,\n      text: m.message.text || '', source_link: '', received_at: new Date(m.timestamp).toISOString() });\n  }\n}\nreturn out.map(e => ({ json: { ...e, last_customer_msg_at: e.received_at } }));\n",
    "mode": "runOnceForAllItems"
   },
