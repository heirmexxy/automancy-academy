  {
   "parameters": {
    "jsCode": "// The signature is computed over the exact raw bytes Meta sent, not over re-serialised JSON.\nconst item = $input.first();\nlet raw;\ntry {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  raw = buf.toString('utf8');\n} catch (e) {\n  raw = JSON.stringify(item.json.body); // fallback only; turn on Raw Body in the webhook options\n}\nreturn [{ json: { raw, signature: item.json.headers['x-hub-signature-256'] || '' } }];\n",
    "mode": "runOnceForAllItems"
   },
   "id": "417b6d52-f9f9-41ba-8e56-dce2249c9e89",
   "name": "Raw body",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    180
   ]
  },
  {
   "parameters": {
    "action": "hmac",
    "type": "SHA256",
    "value": "={{ $json.raw }}",
    "dataPropertyName": "expected",
    "secret": "YOUR_META_APP_SECRET",
    "encoding": "hex"
   },
   "id": "71737653-199e-41ce-8be8-4a5949a40cfd",
