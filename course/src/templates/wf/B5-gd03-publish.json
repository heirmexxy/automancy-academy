    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH u AS (UPDATE posts SET status = 'published', post_id = $2, published_at = now() WHERE id = $1 RETURNING id, platform)\nINSERT INTO events (workflow, event, detail) SELECT 'GD·03', 'published', jsonb_build_object('post', id, 'channel', platform) FROM u\nUNION ALL SELECT 'GD·03', 'api_usage', jsonb_build_object('api', 'x', 'channel', 'x', 'cost_ngn', 25) FROM u WHERE platform = 'x';",
        "options": {
          "queryReplacement": "={{ [ $('Any due').item.json.id, String($json.post_id ?? $json.id ?? $json.data?.id ?? 'manual') ] }}"
        }
      },
