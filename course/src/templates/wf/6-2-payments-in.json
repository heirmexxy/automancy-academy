      "id": "29bb775b-72d3-4a3f-b392-3f9aa15ec9f0",
      "name": "Paystack webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "1dd1c5d6-a5da-41ac-aa07-e7b6467785b7"
    },
    {
      "parameters": {
        "jsCode": "// 1. Signature: HMAC-SHA512 of the raw body with your secret key must equal x-paystack-signature.\nconst crypto = require('crypto');\nconst secret = $env.PAYSTACK_SECRET_KEY;          // TEST secret key, kept in ONE place: the n8n environment\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst sig = String(headers['x-paystack-signature'] || '');\nlet raw = '';\nif (item.binary && item.binary.data) {\n  raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n}\nlet valid = false;\nif (secret && raw && sig) {\n  const hash = crypto.createHmac('sha512', secret).update(raw).digest('hex');\n  valid = hash.length === sig.length && crypto.timingSafeEqual(Buffer.from(hash), Buffer.from(sig));\n}\nlet body = item.json.body;\nif ((!body || typeof body !== 'object') && raw) { try { body = JSON.parse(raw); } catch (e) { body = {}; } }\nbody = body || {};\nreturn [{ json: {\n  signature_valid: valid,\n  reason: !secret ? 'PAYSTACK_SECRET_KEY not set' : !raw ? 'raw body missing' : !sig ? 'no signature header' : valid ? 'ok' : 'signature mismatch',\n  event: body.event || '',\n  reference: (body.data && body.data.reference) || '',\n  body\n} }];"
      },
