    {
      "parameters": {
        "jsCode": "// 2. Only Paystack's own answer counts. Amounts are in kobo.\nconst TIERS = {\n  starter: { deposit: 225000, monthly: 30000 },\n  growth:  { deposit: 425000, monthly: 60000 },\n  partner: { deposit: 600000, monthly: 120000 }\n};\nconst v = $input.first().json.data || {};\nconst hook = $('Verify signature').first().json.body.data || {};\nconst meta = v.metadata || hook.metadata || {};\nconst fields = Array.isArray(meta.custom_fields) ? meta.custom_fields : [];\nconst field = (name) => (fields.find(f => (f.display_name || f.variable_name || '').toLowerCase() === name) || {}).value;\nconst tierKey = String(meta.tier || field('tier') || '').toLowerCase().split(/[\\s:]/)[0];\nconst isRenewal = !!(v.plan && (v.plan.plan_code || typeof v.plan === 'string'));\nconst tier = TIERS[tierKey];\nconst expectedNgn = tier ? (isRenewal ? tier.monthly : tier.deposit) : null;\nconst ok = v.status === 'success' && tier !== undefined && v.amount === expectedNgn * 100 && v.currency === 'NGN';\nreturn [{ json: {\n  verified: ok,\n  why: v.status !== 'success' ? 'Paystack status is ' + (v.status || 'unknown') : !tier ? 'tier missing in metadata' : ok ? 'ok' : 'amount ' + v.amount + ' kobo, expected ' + (expectedNgn * 100),\n  reference: v.reference || $('Verify signature').first().json.reference,\n  kind: isRenewal ? 'monthly' : 'deposit',\n  tier: tierKey ? tierKey[0].toUpperCase() + tierKey.slice(1) : '',\n  amount_ngn: (v.amount || 0) / 100,\n  business: field('business name') || meta.business_name || '',\n  contact: [v.customer && v.customer.first_name, v.customer && v.customer.last_name].filter(Boolean).join(' '),\n  email: (v.customer && v.customer.email || '').toLowerCase(),\n  paid_at: v.paid_at || new Date().toISOString()\n} }];"
      },
