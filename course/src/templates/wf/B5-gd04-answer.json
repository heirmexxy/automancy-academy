    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"action\": \"private_reply\",\n  \"public_text\": \"Thanks! We've sent you a message.\",\n  \"private_text\": \"Hi! A basket of tomatoes is ₦9,500 today, delivered same morning in Ibadan. Want one?\",\n  \"lead\": {\n    \"is_lead\": true,\n    \"business\": false,\n    \"company\": null\n  }\n}"
      },
      "id": "61504c6e-5c34-4648-985b-700d25799ec0",
      "name": "Reply JSON",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2420,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "const c = $('Allowed actions (code)').item.json;\nconst r = $json.output || $json;\nlet action = r.action;\nconst map = { public_reply: 'public', private_reply: 'private', hide: 'hide' };\nif (c.intent === 'spam' && c.has_link) action = 'hide';                       // spam with a link: hidden, no reply\nelse if (action !== 'handover' && !c.allowed[map[action]]) action = c.allowed.public ? 'public_reply' : 'handover';\nif (!c.allowed.auto && action !== 'hide') action = 'handover';                  // complaints, urgent: a person\nif (action === 'private_reply' && !c.allowed.private) action = 'public_reply';  // Facebook comment 9 days old: public only\nreturn { json: { ...c, action, public_text: r.public_text || '', private_text: r.private_text || '',\n  lead: r.lead || {}, is_lead: !!(r.lead && r.lead.is_lead) || c.intent === 'lead' } };",
        "mode": "runOnceForEachItem"
      },
      "id": "b5d568da-9627-484b-9963-78f2c9bbdc54",
      "name": "Enforce allowed",
