      "id": "3191a2f4-9cdb-468d-b21d-2f5bf0f62b65",
      "name": "Label model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1760,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "// Code decides what is allowed; the AI only chooses among these.\nconst e = $('Valid events').item.json;\nconst L = $json.output || $json;\nconst h = (Date.now() - new Date(e.received_at)) / 36e5;\nconst meta = ['facebook', 'instagram'].includes(e.platform);\nconst allowed = {\n  public:  true,\n  private: meta && h <= 24 * 7,           // one private reply per comment, within 7 days\n  hide:    L.intent === 'spam',\n  auto:    ['question', 'praise', 'lead'].includes(L.intent) && !L.urgent\n};\nreturn { json: { ...e, ...L, hours_old: Math.round(h * 10) / 10, allowed } };",
        "mode": "runOnceForEachItem"
      },
      "id": "c4b5f6df-2e32-4294-8076-297e0a10065a",
      "name": "Allowed actions (code)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        270
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Comment ({{ $json.platform }}, {{ $json.hours_old }} h old): \"{{ $json.text }}\"\nIntent: {{ $json.intent }}. Allowed actions: {{ Object.entries($json.allowed).filter(([k, v]) => v && k !== 'auto').map(([k]) => k).join(', ') }}\nPrice list: {{ $('Price list').first().json.prices }}",
        "messages": {
          "messageValues": [
            {
              "message": "You answer social comments for Harvest Lane (fresh produce, Ibadan). Short, warm replies. Public replies never contain personal details or prices for a specific person. Buyers asking a price get the price in a PRIVATE reply when 'private' is allowed, with a short public 'We've sent you a message'. Choose action from: public_reply, private_reply, hide, handover. Spam with a link: hide. Complaints, food safety and anything unsure: handover. Use only prices from the list. Return JSON."
            }
          ]
        },
        "hasOutputParser": true
      },
      "id": "919ebc5f-c881-40aa-96ac-e065d4cdf62f",
      "name": "Draft reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
