    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first();\nconst sig = String((item.json.headers || {})['x-hub-signature-256'] || '');\nlet raw = '';\nif (item.binary && item.binary.data) raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst secret = $env.META_APP_SECRET;\nlet valid = false;\nif (secret && raw && sig.startsWith('sha256=')) {\n  const h = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\n  valid = h.length === sig.length && crypto.timingSafeEqual(Buffer.from(h), Buffer.from(sig));\n}\nif (!valid) return [{ json: { valid: false } }];\nconst body = item.json.body || JSON.parse(raw);\nconst platform = body.object === 'instagram' ? 'instagram' : 'facebook';\nconst out = [];\nfor (const e of (body.entry || [])) {\n  for (const ch of (e.changes || [])) {\n    const v = ch.value || {};\n    if (ch.field === 'feed' && v.item === 'comment' && v.verb === 'add' && v.from?.id !== e.id)\n      out.push({ platform: 'facebook', kind: 'comment', item_id: v.comment_id, thread_id: v.post_id, author_id: v.from?.id, author_name: v.from?.name || '', text: v.message || '', received_at: new Date((v.created_time || Date.now() / 1000) * 1000).toISOString(), link: v.post?.permalink_url || '' });\n    if (ch.field === 'comments' && v.from?.id !== e.id)\n      out.push({ platform: 'instagram', kind: 'comment', item_id: v.id, thread_id: v.media?.id, author_id: v.from?.id, author_name: v.from?.username || '', text: v.text || '', received_at: new Date().toISOString(), link: '' });\n  }\n  for (const m of (e.messaging || [])) {\n    if (!m.message || m.message.is_echo) continue;\n    out.push({ platform, kind: 'dm', item_id: m.message.mid, thread_id: m.sender.id, author_id: m.sender.id, author_name: '', text: m.message.text || '', received_at: new Date(m.timestamp).toISOString(), link: '' });\n  }\n}\nreturn out.length ? out.map(json => ({ json: { valid: true, ...json } })) : [{ json: { valid: true, empty: true } }];"
      },
