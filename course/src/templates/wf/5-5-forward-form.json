   "parameters": {
    "jsCode": "const b = $('Form submitted (POST)').first().json.body;\nconst now = new Date().toISOString();\nreturn [{ json: { platform: b.platform === 'tiktok' ? 'tiktok' : 'linkedin', kind: 'comment',\n  item_id: 'form-' + Date.now(), thread_id: b.link, author_handle: b.author_handle || '', text: b.text,\n  source_link: b.link, received_at: now, last_customer_msg_at: now } }];\n",
