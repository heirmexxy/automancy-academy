   "parameters": {
    "respondWith": "text",
    "responseBody": "<!doctype html><html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Forward a comment</title>\n<style>body{font-family:sans-serif;max-width:480px;margin:24px auto;padding:0 16px}label{display:block;margin-top:12px}input,select,textarea{width:100%;padding:8px;font-size:16px}button{margin-top:16px;padding:10px 16px;font-size:16px}</style></head>\n<body><h2>Forward a comment to the inbox</h2>\n<form method=\"POST\">\n<label>Platform<select name=\"platform\"><option value=\"linkedin\">LinkedIn</option><option value=\"tiktok\">TikTok</option></select></label>\n<label>Link to the comment<input name=\"link\" type=\"url\" required></label>\n<label>Their handle (no phone numbers)<input name=\"author_handle\"></label>\n<label>What they wrote<textarea name=\"text\" rows=\"5\" required></textarea></label>\n<label>Team passcode<input name=\"passcode\" type=\"password\" required></label>\n<button type=\"submit\">Forward</button></form></body></html>",
