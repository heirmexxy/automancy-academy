        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { hs_timestamp: $json.task.due, hs_task_subject: $json.task.subject, hs_task_status: 'NOT_STARTED', hubspot_owner_id: $json.owner }, associations: [{ to: { id: $json.deal_id }, types: [{ associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 216 }] }] }) }}",
        "options": {}
      },
      "id": "9c726bfe-866f-49d0-99b7-076934fa15ed",
      "name": "Create task on deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
