              "id": "cd1e758e-c7b9-4d31-88c3-230d55356f6b",
              "leftValue": "={{ $json.task ? 'yes' : '' }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a6ec547d-bc27-4e1c-913b-4cea2900ef2b",
      "name": "Has a task",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        1320,
        0
