      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO events (workflow, event, detail) VALUES ('GD·08', 'crm_task', $1::jsonb) RETURNING 1;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify({ deal: $('Task for this stage').item.json.deal_id, stage: $('Task for this stage').item.json.stage, task: $('Task for this stage').item.json.task.subject }) ] }}"
        }
      },
      "id": "7852fd83-3808-4e4d-908b-48fd5b9242a1",
      "name": "Log task",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
