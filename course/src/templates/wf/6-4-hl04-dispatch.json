    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "={{ $json.telegram_chat_id }}",
        "message": "=🛵 Job {{ $('Get order and customer').item.json.order_id }} · {{ $('Get order and customer').item.json.zone }}\n{{ $('Get order and customer').item.json.items.map(l => l.quantity + ' × ' + l.name).join('\\n') }}\nCustomer: {{ $('Get order and customer').item.json.name }} {{ $('Get order and customer').item.json.wa_phone }}",
        "approvalOptions": {
          "values": {
            "approvalType": "single",
            "approveLabel": "Accept"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 15,
              "resumeUnit": "minutes"
            }
          }
        }
      },
      "id": "6d430c5c-0910-4bcc-95d9-da9e380c7f8b",
      "name": "Job to rider: Accept",
