    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH d AS (UPDATE deliveries SET accepted_at = now() WHERE order_id = $1 RETURNING order_id)\nINSERT INTO events (workflow, order_id, event, detail)\nSELECT 'HL·04', order_id, 'dispatched', jsonb_build_object('rider', $2) FROM d;",
        "options": {
          "queryReplacement": "={{ [ $('Get order and customer').item.json.order_id, $('Assign nearest free rider').item.json.name ] }}"
        }
      },
      "id": "e70a236f-17ca-48fd-81f2-4c514fed6510",
