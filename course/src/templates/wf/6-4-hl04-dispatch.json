        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=🛵 No free rider for {{ $('Get order and customer').item.json.order_id }} ({{ $('Get order and customer').item.json.zone }}). Please assign one by hand.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "22e2f9a8-274d-445a-8e8c-e1c448858b34",
