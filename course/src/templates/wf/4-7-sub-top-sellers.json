    {
      "parameters": {
        "jsCode": "// Top sellers over the last 7 days, from Orders.\nconst since = $now.setZone('Africa/Lagos').minus({ days: 7 }).toISO();\nconst qty = {};\nfor (const o of $input.all().map(i => i.json)) {\n  if (!o.created_at || String(o.created_at) < since) continue;\n  let lines = [];\n  try { lines = JSON.parse(o.items_json); } catch (e) { continue; }\n  for (const l of lines) qty[l.name] = (qty[l.name] || 0) + Number(l.qty || 0);\n}\nconst top = Object.entries(qty).sort((a, b) => b[1] - a[1]).slice(0, 5)\n  .map(([product, units]) => ({ product, units_sold: units, source: 'Harvest Lane Orders, last 7 days' }));\nreturn [{ json: { top_sellers: top } }];"
      },
