  {
   "parameters": {
    "operation": "executeQuery",
    "query": "insert into marketing_consent (email, status, suppressed_at)\nvalues ($1, $2, now())\non conflict (email) do update set status = excluded.status, suppressed_at = now();",
    "options": {
     "queryReplacement": "={{ [ $json.email, $json.status ] }}"
    }
   },
