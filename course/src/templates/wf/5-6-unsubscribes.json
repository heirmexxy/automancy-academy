  {
   "parameters": {
    "jsCode": "const events = Array.isArray($json.body) ? $json.body : [$json.body];\nconst map = { unsubscribed: 'unsubscribed', unsubscribe: 'unsubscribed', hard_bounce: 'hard_bounce', hardBounce: 'hard_bounce', spam: 'complaint', complaint: 'complaint' };\nreturn events.filter(e => e && e.email && map[e.event])\n  .map(e => ({ json: { email: String(e.email).trim().toLowerCase(), status: map[e.event] } }));\n",
    "mode": "runOnceForAllItems"
   },
   "id": "39b89d3b-737f-4fe4-a8a4-6163d1c96deb",
   "name": "Map event",
