   "name": "Read Mentions",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    220,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.level === 'today' && r.alerted !== 'yes');\nif (!rows.length) return [];\nconst lines = rows.map((r, i) => `${i + 1}. [${r.topic}] ${r.source}: \"${String(r.text).slice(0, 160)}\" ${r.link}`);\nreturn [{ json: { count: rows.length, summary: `Harvest Lane: ${rows.length} item(s) to handle today\\n\\n` + lines.join('\\n'), ids: rows.map(r => r.item_id) } }];\n",
    "mode": "runOnceForAllItems"
   },
   "id": "952ee570-81fa-4b22-bbf4-21fc832c3668",
   "name": "Today's items",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "YOUR_TELEGRAM_CHAT_ID",
    "text": "={{ $json.summary }}",
    "additionalFields": {
     "appendAttribution": false
    }
   },
   "id": "103cf635-2afc-40e8-89e5-a5313888091d",
   "name": "Send summary",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    660,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "return $('Today\\'s items').first().json.ids.map(id => ({ json: { item_id: id, alerted: 'yes' } }));\n",
    "mode": "runOnceForAllItems"
   },
