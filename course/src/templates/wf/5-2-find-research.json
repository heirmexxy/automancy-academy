   "id": "d97f43db-99b3-4459-b10a-af549f6386c3",
   "name": "Get menu page",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    2200,
    90
   ],
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "jsCode": "// Stands in for n8n's HTML node: turn the home and menu pages into plain text.\nconst strip = (h) => String(h || '')\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&')\n  .replace(/\\s+/g, ' ').trim();\nconst home = strip($('Get home page').item.json.data);\nconst menu = strip($json.data);\nreturn { ...$('One business at a time').item.json, text: (home + ' ' + menu).trim() };\n",
    "mode": "runOnceForEachItem"
   },
   "id": "8b45f54a-a506-4fa8-afbc-e1e1a962002c",
   "name": "HTML",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2420,
    90
   ]
  },
  {
   "parameters": {
    "text": "={{ $json.text.slice(0, 12000) }}",
    "schemaType": "manual",
    "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"offers_delivery\": {\n      \"type\": \"boolean\"\n    },\n    \"office_lunch\": {\n      \"type\": \"boolean\"\n    },\n    \"business_email\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"only an address published on the site\"\n    },\n    \"fact\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"one specific, recent, true detail\"\n    },\n    \"fact_quote\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"the exact words from the page\"\n    }\n  },\n  \"required\": [\n    \"offers_delivery\",\n    \"office_lunch\",\n    \"business_email\",\n    \"fact\",\n    \"fact_quote\"\n  ]\n}",
    "options": {
     "systemPromptTemplate": "You read a restaurant's own website text. Extract only what the page says. business_email must be an address published on the page, otherwise null. fact is one specific, recent, true detail about the business; fact_quote is the exact words from the page that prove it, copied character for character. If there is no such detail, return null for both. Never guess."
    }
   },
   "id": "1c14d0e8-0723-4841-a7f0-12f9f89c051f",
   "name": "Extract facts",
   "type": "@n8n/n8n-nodes-langchain.informationExtractor",
   "typeVersion": 1,
   "position": [
    2640,
    90
   ]
  },
  {
   "parameters": {
    "model": "YOUR_MODEL",
    "options": {}
   },
   "id": "96c175c1-3ee9-4fdf-a370-603b80a98ff9",
   "name": "OpenAI Chat Model",
   "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
   "typeVersion": 1,
   "position": [
    2640,
    288
   ]
  },
  {
   "parameters": {
    "jsCode": "return { ...$('HTML').item.json, ...$json.output, fact_source: $('HTML').item.json.websiteUri };\n",
    "mode": "runOnceForEachItem"
   },
   "id": "229fbb66-ba5a-4c70-92bc-8344a56db0e5",
   "name": "Facts",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2860,
    90
   ]
  },
  {
   "parameters": {
    "jsCode": "const page = $('HTML').item.json.text.toLowerCase();\nconst q = ($json.fact_quote || '').toLowerCase().trim();\nconst verified = q.length > 12 && page.includes(q);\nreturn { ...$json, fact: verified ? $json.fact : null, fact_verified: verified };\n",
    "mode": "runOnceForEachItem"
   },
   "id": "8cc9209b-d2ef-4ff8-a697-286dc442ddfc",
   "name": "Verify fact",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    3080,
    90
   ]
  },
  {
   "parameters": {
    "jsCode": "// Same input, same score, every time. Points come from the ICP sheet (rule, points).\nconst icp = Object.fromEntries($('Read ICP').all().map(r => [String(r.json.rule).trim(), Number(r.json.points) || 0]));\nconst ZONE = ['bodija', 'mokola', 'ring road', 'akobo', 'dugbe'];\nconst p = $json;\nlet score = 0;\nconst reasons = [];\nconst add = (rule, ok, why) => { if (ok) { score += icp[rule] || 0; reasons.push(why); } };\nadd('rating_4', p.rating >= 4.0, `rating ${p.rating}`);\nadd('reviews_100', p.userRatingCount >= 100, `${p.userRatingCount} reviews`);\nadd('delivery', p.offers_delivery === true, 'offers delivery');\nadd('office_lunch', p.office_lunch === true, 'office lunches');\nconst inZone = ZONE.some(z => (p.formattedAddress || '').toLowerCase().includes(z));\nadd('in_zone', inZone, 'in delivery zone');\n// Disqualifiers rule a lead out whatever the score.\nlet route = 'draft';\nif (!inZone) route = 'skip';\nelse if (!p.business_email) route = 'manual';   // contact form or a call instead\nelse if (score < 60) route = 'skip';\nreturn { ...p, fit_score: score, reasons: reasons.join('; '), route };\n",
    "mode": "runOnceForEachItem"
   },
   "id": "8a6a1034-03ce-4e43-a639-9d4ffc15c1f7",
   "name": "Score (ICP)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    3300,
    90
   ]
  },
  {
   "parameters": {
