   "name": "One item per place",
   "type": "n8n-nodes-base.splitOut",
   "typeVersion": 1,
   "position": [
    1320,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "// Only places with a website (the only allowed contact source) that we have not researched before.\nconst known = new Set($('Read Prospects').all().map(r => r.json.place_id).filter(Boolean));\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const p = item.json;\n  if (!p.id || !p.websiteUri || known.has(p.id) || seen.has(p.id)) continue;\n  seen.add(p.id);\n  // Places content is used in memory for this run only; only place_id is written to the sheet.\n  out.push({ json: { place_id: p.id, name: p.displayName?.text || '', rating: p.rating || 0,\n    userRatingCount: p.userRatingCount || 0, websiteUri: p.websiteUri, formattedAddress: p.formattedAddress || '' } });\n}\nreturn out;\n",
    "mode": "runOnceForAllItems"
   },
