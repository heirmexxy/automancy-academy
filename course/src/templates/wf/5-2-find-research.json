   "typeVersion": 3,
   "position": [
    3520,
    90
   ]
  },
  {
   "parameters": {
    "promptType": "define",
    "text": "=Business: {{ $json.name }}\nVerified fact (may be empty): {{ $json.fact || '' }}\nArea: {{ $json.formattedAddress }}",
    "messages": {
     "messageValues": [
      {
       "message": "Write the body of a short outreach email using exactly this template. Fill only [business] and [fact]. Change nothing else.\n\nHi [business] team,\n\nI saw that you [fact].\n\nHarvest Lane delivers farm-fresh tomatoes, peppers and greens to kitchens every morning, priced weekly with no minimum order. Would a free sample crate next Tuesday be useful?\n\nIf the verified fact is empty, replace the line 'I saw that you [fact].' with one general line about busy kitchens in their area. Never invent a detail, compliment, branch, award or number. Do not add a signature or an opt-out line. Return only the email body."
      }
     ]
    }
   },
   "id": "1928fed6-f68d-408f-8b3b-6a3e3de6f402",
   "name": "Draft email",
   "type": "@n8n/n8n-nodes-langchain.chainLlm",
   "typeVersion": 1.5,
   "position": [
    3740,
    -36
   ]
  },
  {
   "parameters": {
    "model": "YOUR_MODEL",
    "options": {}
   },
   "id": "78649995-f906-4604-999b-1ade7f54d247",
   "name": "OpenAI Chat Model (draft)",
   "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
   "typeVersion": 1,
   "position": [
    3740,
    162
   ]
  },
  {
   "parameters": {
    "jsCode": "// Code enforces what the AI can't be trusted with. It appends identity and opt-out itself.\nconst p = $('Score (ICP)').item.json;\nconst body = String($json.text || '').trim();\nconst problems = [];\nconst words = body.split(/\\s+/).filter(Boolean).length;\nif (words > 120) problems.push(`too long (${words} words)`);\nif ((body.match(/\\?/g) || []).length !== 1) problems.push('must ask exactly one question');\nconst spam = ['guarantee', 'act now', '100%', 'winner', 'urgent', 'cheapest', 'risk-free', '!!!', 'FREE'];\nfor (const s of spam) { if (s === 'FREE' ? body.includes('FREE') : body.toLowerCase().includes(s)) problems.push(`spam word: ${s}`); }\nif (/\\[(business|fact)\\]/i.test(body)) problems.push('unfilled placeholder');\nif (!p.fact && /i saw that you/i.test(body)) problems.push('personal line without a verified fact');\nconst draft = body + '\\n\\nTolu Adebayo\\nHarvest Lane, Bodija, Ibadan\\n\\nNot interested? Reply STOP and we will never email you again.';\nreturn {\n  place_id: p.place_id,\n  status: problems.length ? 'needs_edit' : 'drafted',\n  fit_score: p.fit_score,\n  reasons: p.reasons + (problems.length ? ' | lint: ' + problems.join(', ') : ''),\n  fact: p.fact || '',\n  fact_source: p.fact ? p.fact_source : '',\n  subject: `Fresh produce for ${p.name}, delivered every morning`,\n  draft,\n  business_email: String(p.business_email).trim().toLowerCase(),\n};\n",
    "mode": "runOnceForEachItem"
   },
   "id": "b2cebcfa-a0e5-4a3b-adc4-7e7cb8ca3e67",
   "name": "Lint draft",
