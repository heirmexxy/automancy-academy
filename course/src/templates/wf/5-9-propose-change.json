    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const ALLOWED = ['merge_companies', 'bulk_update_property', 'create_task', 'require_field', 'score_weight'];\nconst parse = (v, fb) => { if (typeof v !== 'string') return v ?? fb; try { return JSON.parse(v); } catch (e) { return fb; } };\nconst p = $json;\nconst target_ids = parse(p.target_ids, []);\nconst details = parse(p.details, {});\nlet error = '';\nif (!ALLOWED.includes(p.action)) error = `\"${p.action}\" is not on the allowed list (${ALLOWED.join(', ')}). Deleting, changing stages, messaging customers and changing permissions can never be proposed.`;\nelse if (!p.evidence) error = 'Every proposal needs evidence.';\nreturn { valid: !error, error, action: p.action, target_ids, details, evidence: p.evidence || '', expected_effect: p.expected_effect || '',\n  reversible: p.reversible === true || String(p.reversible) === 'true' };\n",
    "mode": "runOnceForEachItem"
   },
   "id": "67cf3f16-6d17-47b4-aa39-b4b8c57449a8",
   "name": "Validate proposal",
