              "resumeAmount": 72,
              "resumeUnit": "hours"
            }
          }
        }
      },
      "id": "80ba747a-7e8c-49ae-8c7b-342f8bf89fac",
      "name": "Ask Tolu",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        -90
      ],
      "webhookId": "b8654c4b-1be7-4291-a961-0e3174e16494"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH u AS (UPDATE suppliers SET status = $2 WHERE id = $1 RETURNING id)\nINSERT INTO events (workflow, event, detail) SELECT 'HL·08', 'supplier_' || $2, jsonb_build_object('supplier_id', id) FROM u;",
        "options": {
          "queryReplacement": "={{ [ $('Store pending supplier').item.json.id, $json.data?.approved === true ? 'approved' : 'rejected' ] }}"
        }
      },
      "id": "31a349c2-6b2e-40bd-85e1-dee2b5309081",
      "name": "Save decision",
