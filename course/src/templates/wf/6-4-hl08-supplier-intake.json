    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "message": "=🧑‍🌾 New supplier: {{ $('Validate').item.json.business_name }} ({{ $('Validate').item.json.area }})\nContact: {{ $('Validate').item.json.contact_name }} {{ $('Validate').item.json.phone }}\nProducts: {{ $('Validate').item.json.products }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve",
            "disapproveLabel": "Reject"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
