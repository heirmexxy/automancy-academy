    {
      "parameters": {
        "jsCode": "// 1. One phone format for everyone\nconst normPhone = p => {\n  const d = String(p ?? '').replace(/\\D/g, '');       // keep digits only\n  if (!d) return null;\n  if (d.startsWith('234')) return '+' + d;\n  if (d.startsWith('0')) return '+234' + d.slice(1);\n  return '+234' + d;\n};\n\n// 2. Group orders by phone\nconst byPhone = {};\nfor (const item of $input.all()) {\n  const o = item.json;\n  const phone = normPhone(o.phone);\n  if (!phone) continue;                               // no phone: handled by an IF before this node\n  const c = byPhone[phone] ??= {\n    phone, name: String(o.name).trim(), orders: 0,\n    lifetime_value: 0, first_order: o.date, last_order: o.date,\n  };\n  c.orders += 1;\n  c.lifetime_value += Number(o.total) || 0;           // \"45000\" → 45000\n  if (o.date < c.first_order) c.first_order = o.date;\n  if (o.date > c.last_order) { c.last_order = o.date; c.name = String(o.name).trim(); }\n}\n\n// 3. Rank by value and return items\nreturn Object.values(byPhone)\n  .sort((a, b) => b.lifetime_value - a.lifetime_value)\n  .map((c, i) => ({ json: { ...c, rank: i + 1 } }));\n"
      },
