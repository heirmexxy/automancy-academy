        "jsCode": "// Approval can take hours: re-check the windows before anything is sent.\nconst m = $('Who sends?').item.json;\nconst h = (Date.now() - new Date(m.received_at)) / 36e5;\nconst sinceCustomer = (Date.now() - new Date(m.last_customer_msg_at)) / 36e5;\nif (['private_reply', 'public_and_private'].includes(m.action) && !(h <= 24 * 7)) throw new Error('Private reply window closed while waiting for approval: reply by hand. Item ' + m.item_id);\nif (m.action === 'dm' && !(sinceCustomer <= 24)) throw new Error('24-hour DM window closed while waiting for approval: reply by hand. Item ' + m.item_id);\nreturn m;\n",
        "mode": "runOnceForEachItem"
      },
