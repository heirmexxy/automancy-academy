        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"action\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"public_reply\",\n        \"private_reply\",\n        \"public_and_private\",\n        \"dm\",\n        \"hide\",\n        \"handover\"\n      ]\n    },\n    \"public_text\": {\n      \"type\": \"string\"\n    },\n    \"private_text\": {\n      \"type\": \"string\"\n    },\n    \"lead\": {\n      \"type\": \"boolean\",\n      \"description\": \"true if this message is a buying signal saved with save_lead\"\n    }\n  },\n  \"required\": [\n    \"action\",\n    \"public_text\",\n    \"private_text\",\n    \"lead\"\n  ]\n}"
      },
      "id": "741c7b57-fca0-4155-ba61-26401cad70cb",
      "name": "Agent output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2200,
        251
      ]
    },
    {
      "parameters": {
        "jsCode": "const m = $('Allowed actions').item.json;\nconst a = m.allowed;\nconst o = $json.output || {};\nconst meta = ['facebook', 'instagram'].includes(m.platform);\nconst assisted = ['linkedin', 'tiktok'].includes(m.platform);\nconst needs = { public_reply: ['public'], private_reply: ['private'], public_and_private: ['public', 'private'], dm: ['dm'], hide: ['public'], handover: [] };\nlet action = o.action, reason = '';\nif (!(action in needs)) { action = 'handover'; reason = 'unknown action'; }\nelse if (needs[action].some(k => !a[k])) { reason = `${action} is not allowed here`; action = 'handover'; }\nif (action === 'hide' && !meta) { action = 'handover'; reason = 'hide is only for Facebook and Instagram comments'; }\nif (m.platform === 'x' && ['private_reply', 'public_and_private', 'dm'].includes(action)) { action = 'handover'; reason = 'X: public replies only in this build'; }\n// Personal details never go in public.\nconst personal = /(\\+?234|\\b0)[789]\\d{9}|[\\w.+-]+@[\\w-]+\\.\\w+|\\bHL-\\d+|\\d+\\s+\\w+\\s+(road|rd|street|st|close|avenue|ave|crescent)\\b/i;\nif (['public_reply', 'public_and_private'].includes(action) && personal.test(o.public_text || '')) { action = 'handover'; reason = 'personal details in a public reply'; }\nlet route = 'auto';\nif (action === 'handover' || assisted) route = 'tolu';\nelse if (!a.auto) route = 'approve';\nreturn { ...m, action, public_text: o.public_text || '', private_text: o.private_text || '', lead: !!o.lead, reject_reason: reason, route };\n",
        "mode": "runOnceForEachItem"
      },
