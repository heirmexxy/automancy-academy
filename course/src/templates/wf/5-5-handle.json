    {
      "parameters": {
        "jsCode": "const row = $('Save to inbox (skip duplicates)').item.json;\nreturn { ...row, intent: $json.output.intent, urgent: $json.output.urgent, sentiment: $json.output.sentiment, topic: $json.output.topic };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "660fcbe8-0bb6-42ed-959c-8feed6c8edb5",
      "name": "Combine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const h = (Date.now() - new Date($json.received_at)) / 36e5;\nconst sinceCustomer = (Date.now() - new Date($json.last_customer_msg_at)) / 36e5;\nconst meta = ['facebook','instagram'].includes($json.platform);\nreturn { ...$json, allowed: {\n  public:  $json.kind !== 'dm',\n  private: meta && $json.kind === 'comment' && h <= 24*7 && !$json.private_sent,\n  dm:      $json.kind === 'dm' && sinceCustomer <= 24,\n  auto:    ['question','praise','lead'].includes($json.intent) && !$json.urgent\n}};\n",
        "mode": "runOnceForEachItem"
      },
      "id": "f0c209dd-d54b-4e2e-b1a1-6aa23c491882",
      "name": "Allowed actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update inbox set intent = $1, urgent = $2 where item_id = $3;",
        "options": {
          "queryReplacement": "={{ [ $json.intent, $json.urgent, $json.item_id ] }}"
        }
      },
      "id": "931d458b-a95b-4f79-a22b-8e9513022494",
      "name": "Save labels",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Platform: {{ $('Allowed actions').item.json.platform }} · kind: {{ $('Allowed actions').item.json.kind }}\nIntent: {{ $('Allowed actions').item.json.intent }} · urgent: {{ $('Allowed actions').item.json.urgent }}\nallowed: {{ JSON.stringify($('Allowed actions').item.json.allowed) }}\n\nMessage from {{ $('Allowed actions').item.json.author_handle }}:\n{{ $('Allowed actions').item.json.text }}",
        "options": {
          "systemMessage": "You are Harvest Lane's social inbox assistant (Sage Desk). Tolu sees everything and steps in when needed; if you write to a customer privately for the first time, say you are Harvest Lane's assistant.\nRules:\n- Short replies.\n- Public replies never contain personal details: no names with addresses, order numbers, phone numbers or refund amounts. Prices and opening hours may be public. When in doubt, move it to private or to a person.\n- Only use actions whose permission is true in \"allowed\". Map: public_reply needs public; private_reply needs private; public_and_private needs both; dm needs dm; hide needs public (spam and scam links only; never reply to spam); handover is always possible.\n- Simple question (price, hours, delivery area): a short public reply plus a private reply with details and the order link (public_and_private), if allowed.\n- Buying signal: private reply or DM, and call save_lead (consent_followup true only if they said yes to a follow-up).\n- Complaint, refund, anger, anything legal or safety-related, a big account, or the customer asks for a person: handover (call handover_to_tolu), with a short suggested reply for Tolu.\n- Praise: a warm thank-you.\n- Never say a message was sent; the system sends it.\n- Use get_price and check_delivery_zone for facts. Never invent prices.\nReturn JSON: { action, public_text, private_text, lead }."
        },
        "hasOutputParser": true
      },
