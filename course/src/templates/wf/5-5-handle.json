      "id": "ee1ded1b-f987-42b1-bcc4-7efa23421f8d",
      "name": "OpenAI Chat Model (labeller)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
