{
 "name": "HL · 8 p.m. run (hardened)",
 "flow": [
  {
   "id": 1,
   "module": "http:ActionSendData",
   "version": 3,
   "parameters": {
    "handleErrors": true,
    "useNewZLibDeCompress": true
   },
   "mapper": {
    "url": "https://api.open-meteo.com/v1/forecast",
    "method": "get",
    "headers": [],
    "qs": [
     {
      "name": "latitude",
      "value": "7.3775"
     },
     {
      "name": "longitude",
      "value": "3.9470"
     },
     {
      "name": "daily",
      "value": "precipitation_probability_max"
     },
     {
      "name": "timezone",
      "value": "Africa/Lagos"
     },
     {
      "name": "forecast_days",
      "value": "2"
     }
    ],
    "bodyType": "",
    "parseResponse": true,
    "serializeUrl": false,
    "shareCookies": false,
    "rejectUnauthorized": true,
    "followRedirect": true,
    "useQuerystring": false,
    "gzip": true,
    "useMtls": false,
    "timeout": ""
   },
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0,
     "name": "HTTP · Weather (Open-Meteo)"
    }
   },
   "onerror": [
    {
     "id": 2,
     "module": "builtin:Resume",
     "version": 1,
     "parameters": {},
     "mapper": {
      "statusCode": 200,
      "data": {
       "daily": {
        "precipitation_probability_max": [
         "unknown",
         "unknown"
        ]
       },
       "timezone": "Africa/Lagos"
      }
     },
     "metadata": {
      "designer": {
       "x": 0,
       "y": 250,
       "name": "Resume"
      }
     }
    }
   ]
  },
  {
   "id": 3,
   "module": "google-sheets:filterRows",
   "version": 2,
   "parameters": {},
   "mapper": {
    "from": "drive",
    "mode": "select",
    "spreadsheetId": "YOUR_ORDERS_SHEET_ID",
    "sheetId": "Orders",
    "includesHeaders": true,
    "tableFirstRow": "A1:Z1",
    "sortOrder": "asc",
    "limit": "",
    "filter": [
     [
      {
       "a": "D",
       "b": "{{formatDate(addDays(now; 1); \"YYYY-MM-DD\")}}",
       "o": "text:equal"
      }
     ]
    ]
   },
   "metadata": {
    "designer": {
     "x": 300,
     "y": 0,
     "name": "Tomorrow's orders"
    }
   }
  },
  {
   "id": 4,
   "module": "builtin:BasicRouter",
   "version": 1,
   "parameters": {},
   "mapper": null,
   "metadata": {
    "designer": {
     "x": 600,
     "y": 0,
     "name": "Sort the orders"
    }
   },
   "filter": {
    "name": "Not cancelled",
    "conditions": [
     [
      {
       "a": "{{3.`5`}}",
       "b": "Cancelled",
       "o": "text:notequal:ci"
      }
     ]
    ]
   },
   "routes": [
    {
     "flow": [
      {
       "id": 5,
       "module": "http:ActionSendData",
       "version": 3,
       "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
       },
       "mapper": {
        "url": "YOUR_WEBHOOK_SITE_URL",
        "method": "post",
        "headers": [],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "serializeUrl": false,
        "shareCookies": false,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "timeout": "",
        "contentType": "application/json",
        "data": "{\"order_id\": \"{{3.`0`}}\", \"customer\": \"{{3.`2`}}\", \"area\": \"{{3.`14`}}\", \"phone\": \"{{3.`8`}}\", \"delivery_date\": \"{{3.`3`}}\"}"
       },
       "metadata": {
        "designer": {
         "x": 900,
         "y": -450,
         "name": "HTTP · Book courier"
        }
       },
       "filter": {
        "name": "Paid or standing",
        "conditions": [
         [
          {
           "a": "{{3.`5`}}",
           "b": "Paid",
           "o": "text:equal"
          }
         ],
         [
          {
           "a": "{{3.`13`}}",
           "b": "standing",
           "o": "text:equal"
          }
         ]
        ]
       },
       "onerror": [
        {
         "id": 6,
         "module": "google-email:ActionSendEmail",
         "version": 4,
         "parameters": {},
         "mapper": {
          "to": [
           "tolu@harvestlane.example"
          ],
          "subject": "Courier booking failed · {{3.`0`}}",
          "bodyType": "rawHtml",
          "contentType": "text",
          "content": "{{error.type}}: {{error.message}}\nOrder {{3.`0`}} for {{3.`2`}}, {{3.`14`}}.\nMake will retry automatically. Check incomplete executions if this repeats."
         },
         "metadata": {
          "designer": {
           "x": 900,
           "y": -700,
           "name": "Gmail · Alert Tolu (courier)"
          }
         }
        },
        {
         "id": 7,
         "module": "builtin:Break",
         "version": 1,
         "parameters": {},
         "mapper": {
          "retry": true,
          "count": 3,
          "interval": 15
         },
         "metadata": {
          "designer": {
           "x": 1200,
           "y": -700,
           "name": "Break · retry"
          }
         }
        }
       ]
      },
      {
       "id": 8,
       "module": "google-sheets:addRow",
       "version": 2,
       "parameters": {},
       "mapper": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "YOUR_DELIVERIES_SHEET_ID",
        "sheetId": "Deliveries",
        "includesHeaders": true,
        "insertUnformatted": false,
        "valueInputOption": "USER_ENTERED",
        "insertDataOption": "INSERT_ROWS",
        "values": {
         "0": "{{3.`3`}}",
         "1": "{{3.`0`}}",
         "2": "{{3.`2`}}",
         "3": "{{3.`14`}}",
         "4": "{{3.`8`}}",
         "5": "{{ifempty(5.data.booking_id; \"booked\")}}",
         "6": "{{get(1.data.daily.precipitation_probability_max; 2)}}{{if(get(1.data.daily.precipitation_probability_max; 2) = \"unknown\"; emptystring; \"%\")}}"
        }
       },
       "metadata": {
        "designer": {
         "x": 1200,
         "y": -450,
         "name": "Google Sheets · Add to Deliveries"
        }
       },
       "onerror": [
        {
         "id": 9,
         "module": "builtin:Break",
         "version": 1,
         "parameters": {},
         "mapper": {
          "retry": true,
          "count": 2,
          "interval": 15
         },
         "metadata": {
          "designer": {
           "x": 1200,
           "y": -250,
           "name": "Break · retry"
          }
         }
        }
       ]
      },
      {
       "id": 10,
       "module": "http:ActionSendDataAPIKeyAuth",
       "version": 3,
       "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
       },
       "mapper": {
        "url": "YOUR_SMS_API_URL",
        "method": "post",
        "headers": [],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "serializeUrl": false,
        "shareCookies": false,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "timeout": "",
        "contentType": "application/json",
        "data": "{\"to\": \"{{3.`8`}}\", \"message\": \"Hi {{3.`9`}}, your Harvest Lane order {{3.`0`}} arrives tomorrow, {{ifempty(3.`16`; \"time to be confirmed\")}}. Rain chance: {{get(1.data.daily.precipitation_probability_max; 2)}}{{if(get(1.data.daily.precipitation_probability_max; 2) = \"unknown\"; emptystring; \"%\")}}.\"}"
       },
       "metadata": {
        "designer": {
         "x": 1500,
         "y": -450,
         "name": "Message customer"
        }
       },
       "onerror": [
        {
         "id": 11,
         "module": "google-sheets:addRow",
         "version": 2,
         "parameters": {},
         "mapper": {
          "from": "drive",
          "mode": "select",
          "spreadsheetId": "YOUR_ERRORS_SHEET_ID",
          "sheetId": "Errors",
          "includesHeaders": true,
          "insertUnformatted": false,
          "valueInputOption": "USER_ENTERED",
          "insertDataOption": "INSERT_ROWS",
          "values": {
           "0": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}",
           "1": "HL · 8 p.m. run",
           "2": "Message customer",
           "3": "{{3.`0`}}",
           "4": "{{error.type}}: {{error.message}}"
          }
         },
         "metadata": {
          "designer": {
           "x": 1500,
           "y": -250,
           "name": "Log to Errors tab"
          }
         }
        },
        {
         "id": 12,
         "module": "builtin:Ignore",
         "version": 1,
         "parameters": {},
         "mapper": {},
         "metadata": {
          "designer": {
           "x": 1800,
           "y": -250,
           "name": "Ignore"
          }
         }
        }
       ]
      }
     ]
    },
    {
     "flow": [
      {
       "id": 13,
       "module": "google-email:ActionSendEmail",
       "version": 4,
       "parameters": {},
       "mapper": {
        "to": [
         "{{3.`15`}}"
        ],
        "subject": "Your Harvest Lane order {{3.`0`}} for tomorrow",
        "bodyType": "rawHtml",
        "contentType": "text",
        "content": "Hi {{3.`9`}}, your order {{3.`0`}} (₦{{formatNumber(3.`7`; 0; \".\"; \",\")}}) is booked for tomorrow but not paid yet. Please pay here: YOUR_PAYMENT_LINK"
       },
       "metadata": {
        "designer": {
         "x": 900,
         "y": -50,
         "name": "Gmail · Payment reminder"
        }
       },
       "filter": {
        "name": "Unpaid customer order",
        "conditions": [
         [
          {
           "a": "{{3.`5`}}",
           "b": "New",
           "o": "text:equal"
          },
          {
           "a": "{{3.`13`}}",
           "b": "standing",
           "o": "text:notequal"
          }
         ]
        ]
       }
      }
     ]
    },
    {
     "flow": [
      {
       "id": 14,
       "module": "google-email:ActionSendEmail",
       "version": 4,
       "parameters": {},
       "mapper": {
        "to": [
         "tolu@harvestlane.example"
        ],
        "subject": "Big order tomorrow · {{3.`0`}}",
        "bodyType": "rawHtml",
        "contentType": "text",
        "content": "{{3.`0`}} for {{3.`2`}}: ₦{{formatNumber(3.`7`; 0; \".\"; \",\")}}, status {{3.`5`}}."
       },
       "metadata": {
        "designer": {
         "x": 900,
         "y": 200,
         "name": "Gmail · Alert Tolu (big order)"
        }
       },
       "filter": {
        "name": "Big order",
        "conditions": [
         [
          {
           "a": "{{3.`7`}}",
           "b": "50000",
           "o": "number:greater"
          }
         ]
        ]
       }
      }
     ]
    },
    {
     "flow": [
      {
       "id": 15,
       "module": "google-sheets:addRow",
       "version": 2,
       "parameters": {},
       "mapper": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "YOUR_ORDERS_SHEET_ID",
        "sheetId": "Needs checking",
        "includesHeaders": true,
        "insertUnformatted": false,
        "valueInputOption": "USER_ENTERED",
        "insertDataOption": "INSERT_ROWS",
        "values": {
         "0": "{{3.`0`}}",
         "1": "{{3.`5`}}",
         "2": "{{3.`13`}}",
         "3": "{{3.`7`}}",
         "4": "Matched no route"
        }
       },
       "metadata": {
        "designer": {
         "x": 900,
         "y": 450,
         "name": "Sheets · Add to Needs checking"
        }
       },
       "filter": {
        "name": "Fallback (none of the above)",
        "conditions": [
         [
          {
           "a": "{{3.`5`}}",
           "b": "Paid",
           "o": "text:notequal"
          },
          {
           "a": "{{3.`13`}}",
           "b": "standing",
           "o": "text:notequal"
          },
          {
           "a": "{{3.`5`}}",
           "b": "New",
           "o": "text:notequal"
          },
          {
           "a": "{{3.`7`}}",
           "b": "50000",
           "o": "number:lessorequal"
          }
         ]
        ]
       }
      }
     ]
    }
   ]
  }
 ],
 "metadata": {
  "instant": false,
  "version": 1,
  "scenario": {
   "roundtrips": 1,
   "maxErrors": 3,
   "autoCommit": true,
   "autoCommitTriggerLast": true,
   "sequential": false,
   "confidential": false,
   "dataloss": false,
   "dlq": true,
   "freshVariables": false
  },
  "designer": {
   "orphans": []
  }
 }
}
