     "name": "Previous month values"
    }
   }
  },
  {
   "id": 13,
   "module": "util:SetVariables",
   "version": 1,
   "parameters": {},
   "mapper": {
    "variables": [
     {
      "name": "gross",
      "value": "{{11.revenue - 11.cogs}}"
     },
     {
      "name": "opex",
      "value": "{{11.fuel + 11.packaging + 11.airtime + 11.rider + 11.other}}"
     },
     {
      "name": "net",
      "value": "{{11.revenue - 11.cogs - (11.fuel + 11.packaging + 11.airtime + 11.rider + 11.other)}}"
     },
     {
      "name": "margin",
      "value": "{{if(11.revenue = 0; 0; round((11.revenue - 11.cogs) / 11.revenue * 1000) / 10)}}"
     }
    ],
    "scope": "roundtrip"
   },
   "metadata": {
    "designer": {
     "x": 2700,
     "y": 0,
     "name": "Profit"
    }
   }
  },
  {
   "id": 14,
   "module": "google-sheets:addRow",
   "version": 2,
   "parameters": {},
   "mapper": {
    "from": "drive",
