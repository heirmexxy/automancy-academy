{
 "name": "Books · 3 Monthly P&L (1st, 07:00)",
 "flow": [
  {
   "id": 1,
   "module": "util:SetVariables",
   "version": 1,
   "parameters": {},
   "mapper": {
    "variables": [
     {
      "name": "this_first",
      "value": "{{formatDate(setDate(now; 1); \"YYYY-MM-DD\")}}"
     },
     {
      "name": "last_first",
      "value": "{{formatDate(addMonths(setDate(now; 1); -1); \"YYYY-MM-DD\")}}"
     },
     {
      "name": "month_label",
      "value": "{{formatDate(addMonths(setDate(now; 1); -1); \"MMMM YYYY\")}}"
     },
     {
      "name": "prev_label",
      "value": "{{formatDate(addMonths(setDate(now; 1); -2); \"MMMM YYYY\")}}"
     }
    ],
    "scope": "roundtrip"
   },
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0,
     "name": "Month boundaries"
    }
   }
  },
  {
   "id": 2,
   "module": "google-sheets:filterRows",
   "version": 2,
   "parameters": {},
   "mapper": {
    "from": "drive",
    "mode": "select",
    "spreadsheetId": "YOUR_ORDERS_SHEET_ID",
    "sheetId": "Orders",
    "includesHeaders": true,
    "tableFirstRow": "A1:Z1",
    "sortOrder": "asc",
    "limit": "5000",
    "filter": [
     [
      {
       "a": "F",
       "b": "Paid",
       "o": "text:equal"
      }
     ]
    ]
   },
   "metadata": {
    "designer": {
     "x": 300,
     "y": 0,
     "name": "Paid orders"
    }
   },
   "onerror": [
    {
     "id": 20,
     "module": "google-sheets:addRow",
     "version": 2,
     "parameters": {},
     "mapper": {
      "from": "drive",
      "mode": "select",
      "spreadsheetId": "YOUR_BOOKS_SHEET_ID",
      "sheetId": "Errors",
      "includesHeaders": true,
      "insertUnformatted": false,
      "valueInputOption": "USER_ENTERED",
      "insertDataOption": "INSERT_ROWS",
      "values": {
       "0": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}",
       "1": "B2 · 3 Monthly P&L",
       "2": "Search Orders",
       "3": "",
       "4": "{{error.type}}",
       "5": "{{error.message}}"
      }
     },
     "metadata": {
      "designer": {
       "x": 300,
       "y": 250,
       "name": "Log to Errors"
      }
     }
    },
    {
     "id": 21,
     "module": "google-email:ActionSendEmail",
     "version": 4,
     "parameters": {},
     "mapper": {
      "to": [
       "tolu@harvestlane.example"
      ],
      "subject": "Books system: Search Orders failed",
      "bodyType": "rawHtml",
      "contentType": "text",
      "content": "B2 · 3 Monthly P&L · Search Orders\n{{error.type}}: {{error.message}}\n\nIt's in the Errors tab. Make will retry automatically if it can."
     },
     "metadata": {
      "designer": {
       "x": 600,
       "y": 250,
       "name": "Alert Tolu"
      }
     }
    },
    {
     "id": 22,
     "module": "builtin:Break",
     "version": 1,
     "parameters": {},
     "mapper": {
      "retry": true,
      "count": 3,
      "interval": 15
     },
     "metadata": {
      "designer": {
       "x": 900,
       "y": 250,
       "name": "Break · retry"
      }
     }
    }
   ]
  },
  {
   "id": 3,
