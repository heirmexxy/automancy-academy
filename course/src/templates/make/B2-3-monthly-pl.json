    "mode": "select",
    "spreadsheetId": "YOUR_BOOKS_SHEET_ID",
    "sheetId": "Monthly_PL",
    "includesHeaders": true,
    "tableFirstRow": "A1:Z1",
    "sortOrder": "asc",
    "limit": "1",
    "filter": [
     [
      {
       "a": "A",
