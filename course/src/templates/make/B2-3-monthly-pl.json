    "subject": "Harvest Lane P&L · {{1.month_label}} · net ₦{{formatNumber(13.net; 0; \".\"; \",\")}}",
    "bodyType": "rawHtml",
    "contentType": "html",
    "content": "<p>Harvest Lane · {{1.month_label}} · all figures ex VAT, ₦</p><table border=\"1\" cellpadding=\"6\" cellspacing=\"0\"><tr><th align=\"left\">Line</th><th>{{1.month_label}}</th><th>{{1.prev_label}}</th><th>Change</th></tr><tr><td>Revenue (paid orders)</td><td align=\"right\">{{formatNumber(11.revenue; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_revenue; 0; \".\"; \",\")}}</td><td align=\"right\">{{if(12.p_revenue = 0; \"n/a\"; formatNumber(round((11.revenue - 12.p_revenue) / 12.p_revenue * 1000) / 10; 1; \".\"; \",\") + \"%\")}}</td></tr><tr><td>Cost of goods</td><td align=\"right\">{{formatNumber(11.cogs; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_cogs; 0; \".\"; \",\")}}</td><td align=\"right\">{{if(12.p_cogs = 0; \"n/a\"; formatNumber(round((11.cogs - 12.p_cogs) / 12.p_cogs * 1000) / 10; 1; \".\"; \",\") + \"%\")}}</td></tr><tr><td>Gross profit (margin {{13.margin}}%)</td><td align=\"right\">{{formatNumber(13.gross; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_gross; 0; \".\"; \",\")}}</td><td align=\"right\">{{if(12.p_gross = 0; \"n/a\"; formatNumber(round((13.gross - 12.p_gross) / 12.p_gross * 1000) / 10; 1; \".\"; \",\") + \"%\")}}</td></tr><tr><td>Fuel</td><td align=\"right\">{{formatNumber(11.fuel; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_fuel; 0; \".\"; \",\")}}</td><td align=\"right\">{{if(12.p_fuel = 0; \"n/a\"; formatNumber(round((11.fuel - 12.p_fuel) / 12.p_fuel * 1000) / 10; 1; \".\"; \",\") + \"%\")}}</td></tr><tr><td>Packaging</td><td align=\"right\">{{formatNumber(11.packaging; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_packaging; 0; \".\"; \",\")}}</td><td align=\"right\">{{if(12.p_packaging = 0; \"n/a\"; formatNumber(round((11.packaging - 12.p_packaging) / 12.p_packaging * 1000) / 10; 1; \".\"; \",\") + \"%\")}}</td></tr><tr><td>Airtime & data</td><td align=\"right\">{{formatNumber(11.airtime; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_airtime; 0; \".\"; \",\")}}</td><td align=\"right\">{{if(12.p_airtime = 0; \"n/a\"; formatNumber(round((11.airtime - 12.p_airtime) / 12.p_airtime * 1000) / 10; 1; \".\"; \",\") + \"%\")}}</td></tr><tr><td>Rider pay</td><td align=\"right\">{{formatNumber(11.rider; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_rider; 0; \".\"; \",\")}}</td><td align=\"right\">{{if(12.p_rider = 0; \"n/a\"; formatNumber(round((11.rider - 12.p_rider) / 12.p_rider * 1000) / 10; 1; \".\"; \",\") + \"%\")}}</td></tr><tr><td>Other</td><td align=\"right\">{{formatNumber(11.other; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_other; 0; \".\"; \",\")}}</td><td align=\"right\">{{if(12.p_other = 0; \"n/a\"; formatNumber(round((11.other - 12.p_other) / 12.p_other * 1000) / 10; 1; \".\"; \",\") + \"%\")}}</td></tr><tr><td>Operating expenses</td><td align=\"right\">{{formatNumber(13.opex; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_opex; 0; \".\"; \",\")}}</td><td align=\"right\">{{if(12.p_opex = 0; \"n/a\"; formatNumber(round((13.opex - 12.p_opex) / 12.p_opex * 1000) / 10; 1; \".\"; \",\") + \"%\")}}</td></tr><tr><td>Net profit</td><td align=\"right\">{{formatNumber(13.net; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_net; 0; \".\"; \",\")}}</td><td align=\"right\">{{if(12.p_net = 0; \"n/a\"; formatNumber(round((13.net - 12.p_net) / 12.p_net * 1000) / 10; 1; \".\"; \",\") + \"%\")}}</td></tr><tr><td>VAT paid on purchases (separate)</td><td align=\"right\">{{formatNumber(11.vat_paid; 0; \".\"; \",\")}}</td><td align=\"right\">{{formatNumber(12.p_vat; 0; \".\"; \",\")}}</td><td></td></tr></table><p>{{length(3.array)}} paid orders · {{length(5.array)}} expense documents. Bookkeeping support, not tax or accounting advice: the accountant reviews before any filing.</p>"
   },
