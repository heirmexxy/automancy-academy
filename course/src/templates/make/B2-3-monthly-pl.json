   "version": 1,
   "parameters": {
    "feeder": 2
   },
   "mapper": {
    "order_id": "{{2.`0`}}",
    "total": "{{2.`7`}}"
   },
   "metadata": {
    "designer": {
     "x": 600,
     "y": 0,
     "name": "Orders last month"
    }
   },
   "filter": {
    "name": "Paid last month",
    "conditions": [
     [
      {
       "a": "{{formatDate(2.`12`; \"YYYY-MM-DD\")}}",
       "b": "{{1.last_first}}",
       "o": "text:greaterorequal"
      },
      {
       "a": "{{formatDate(2.`12`; \"YYYY-MM-DD\")}}",
       "b": "{{1.this_first}}",
       "o": "text:less"
      }
     ]
    ]
   }
  },
