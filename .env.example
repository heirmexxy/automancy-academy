# ─────────────────────────────────────────────────────────────────────────────
# Automancy Academy · environment variables
# Copy to .env.local for local development, and add the same keys in Vercel.
# Every value below marked PLACEHOLDER must be replaced before going live.
# ─────────────────────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=https://automancy.cc
NEXT_PUBLIC_SUPPORT_EMAIL=support@automancy.cc        # PLACEHOLDER: a real inbox you read
ADMIN_EMAILS=you@example.com                                  # PLACEHOLDER: comma-separated; these accounts become admins on sign-up

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co     # PLACEHOLDER
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY          # PLACEHOLDER
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY      # PLACEHOLDER · server only, never expose

# Paystack (Settings → API Keys & Webhooks). Leave empty to run in placeholder mode (no charges; admin grants access).
PAYSTACK_SECRET_KEY=                                          # PLACEHOLDER: sk_test_… while testing, sk_live_… at launch
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=                              # PLACEHOLDER: pk_test_… / pk_live_…

# AI reviewer and course assistant (Anthropic API). Leave empty and reviews queue for a person.
ANTHROPIC_API_KEY=                                            # PLACEHOLDER
ANTHROPIC_MODEL=claude-sonnet-5-5                             # check the current model name before launch

# Natural Nigerian voices (Azure AI Speech: en-NG-AbeoNeural / en-NG-EzinneNeural). Leave empty to use browser voices.
AZURE_SPEECH_KEY=                                             # PLACEHOLDER
AZURE_SPEECH_REGION=westeurope                                # PLACEHOLDER: your Speech resource's region

# Email (Resend). Leave empty and emails are logged instead of sent.
RESEND_API_KEY=                                               # PLACEHOLDER
EMAIL_FROM="Automancy Academy <hello@automancy.cc>"   # PLACEHOLDER: a sender on a verified domain

# Learning on WhatsApp (Meta WhatsApp Cloud API). Leave empty: the account page says "coming soon" and the webhook returns 503.
WHATSAPP_TOKEN=                                               # PLACEHOLDER: permanent System User token (whatsapp_business_messaging + whatsapp_business_management)
WHATSAPP_PHONE_NUMBER_ID=                                     # PLACEHOLDER: Meta app → WhatsApp → API Setup → Phone number ID
WHATSAPP_APP_SECRET=                                          # PLACEHOLDER: Meta app → App settings → Basic → App secret (webhook signature)
WHATSAPP_VERIFY_TOKEN=                                        # PLACEHOLDER: any long random string; same value in the Meta webhook settings
WHATSAPP_BUSINESS_NUMBER=                                     # PLACEHOLDER: the Automancy number, digits with country code, e.g. 2348012345678
WHATSAPP_GRAPH_VERSION=v21.0                                  # PLACEHOLDER: check Meta's current Graph API version
WHATSAPP_TEMPLATE_REMINDER=lesson_reminder                    # approved Utility template, language en, one body variable
CRON_SECRET=                                                  # PLACEHOLDER: long random string; Vercel Cron sends it as a Bearer token to /api/whatsapp/reminders
